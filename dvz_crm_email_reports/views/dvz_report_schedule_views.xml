<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dvz_report_schedule_view_form" model="ir.ui.view">
        <field name="name">dvz.crm.report.schedule.form</field>
        <field name="model">dvz.crm.report.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_download_excel" string="Download Excel"
                            type="object" class="btn-secondary"/>
                    <button name="action_send_now" string="Send Now"
                            type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Which Leads">
                            <field name="team_ids" widget="many2many_tags"/>
                            <field name="salesperson_ids" widget="many2many_tags"/>
                            <field name="date_range_mode"/>
                            <field name="date_from" invisible="date_range_mode != 'range'"/>
                            <field name="date_to" invisible="date_range_mode != 'range'"/>
                        </group>
                        <group string="Send to Head">
                            <field name="send_to_head"/>
                            <field name="head_user_ids" widget="many2many_tags"
                                   invisible="not send_to_head"/>
                        </group>
                    </group>
                    <group>
                        <group string="Automatic Sending">
                            <field name="frequency_per_day"/>
                            <field name="last_sent_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dvz_report_schedule_view_list" model="ir.ui.view">
        <field name="name">dvz.crm.report.schedule.list</field>
        <field name="model">dvz.crm.report.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_ids" widget="many2many_tags"/>
                <field name="salesperson_ids" widget="many2many_tags"/>
                <field name="date_range_mode"/>
                <field name="send_to_head"/>
                <field name="frequency_per_day"/>
                <field name="last_sent_at"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="dvz_report_schedule_action" model="ir.actions.act_window">
        <field name="name">Report Schedules</field>
        <field name="res_model">dvz.crm.report.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a report schedule
            </p>
            <p>
                Set up who gets an automatic Excel export of leads (by
                Team and/or Salesperson), how often, and whether a
                combined per-salesperson-sheet report goes to a Head.
            </p>
        </field>
    </record>

    <menuitem id="dvz_report_schedule_menu" name="Report Schedules"
              parent="crm.crm_menu_config" action="dvz_report_schedule_action"
              sequence="60"/>

</odoo>
