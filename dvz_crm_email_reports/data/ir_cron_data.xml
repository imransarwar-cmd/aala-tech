<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Runs every 30 minutes; each individual schedule's own
             frequency_per_day (checked inside _cron_check_and_send_reports)
             decides whether it's actually due to send this time. -->
        <record id="ir_cron_dvz_crm_report_schedule" model="ir.cron">
            <field name="name">CRM Email Reports: check &amp; send due schedules</field>
            <field name="model_id" ref="model_dvz_crm_report_schedule"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_and_send_reports()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
