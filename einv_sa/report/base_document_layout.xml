<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- report qweb view -->
        <template id="financial_layout_row">
            <div style="border-top:1px solid black;padding-top:4px;margin-top:4px;">
                <div class="row" style="text-align:center;border-bottom:0.5px solid grey;padding-bottom:4px;margin-bottom:4px;">
                    <div class="col-2">CR No:</div>
                    <div class="col-2"><span t-field="company.company_registry"/></div>
                    <div class="col-2">:رقم سجل الشركة</div>
                    <div class="col-2">Vat No:</div>
                    <div class="col-2"><span t-field="company.vat"/></div>
                    <div class="col-2">:الرقم الضريبي</div>
                </div>
<!--                <div class="row" style="text-align:center;border:1px solid lightgrey;padding:4px 0;">-->
<!--                    <div class="col-3">Email:</div>-->
<!--                    <div class="col-3"><span t-field="company.email"/></div>-->
<!--                    <div class="col-3">Web:</div>-->
<!--                    <div class="col-3"><span t-field="company.website"/></div>-->
<!--                </div>-->
            </div>
        </template>

        <template id="financial_layout_row_ul">
            <ul class="list-inline mb4">
                <li t-if="company.company_registry" class="list-inline-item d-inline mx-2">
                    <span>CR No:</span>
                    <span t-field="company.company_registry"></span>
                    <span>:رقم سجل الشركة</span>
                </li>
                <li t-if="company.vat" class="list-inline-item d-inline">
                    <span>Vat No:</span>
                    <span t-field="company.vat"></span>
                    <span>:الرقم الضريبي</span>
                </li>
            </ul>
        </template>

        <template id="einv_header_company_name">
            <div t-if="company.arabic_name" class="o_einv_header_company_name_ar" style="font-weight:bold;text-align:right;" t-field="company.arabic_name"/>
            <div t-else="" class="o_einv_header_company_name" style="font-weight:bold;text-align:right;" t-field="company.name"/>
        </template>

        <template id="einv_external_layout_standard" inherit_id="web.external_layout_standard">
<!--            <xpath expr="//ul[@name='company_address_list']" position="before">-->
<!--                <t t-call="einv_sa.einv_header_company_name"/>-->
<!--            </xpath>-->
            <xpath expr="//*[@t-field='company.report_footer']" position="before">
                <t t-call="einv_sa.financial_layout_row"/>
            </xpath>
            <xpath expr="//ul[@name='company_address_list']/li[@t-if='not forced_vat']/following-sibling::li[1]" position="replace"></xpath>
            <xpath expr="//ul[@name='company_address_list']/li[@t-if='not forced_vat']" position="replace"></xpath>
        </template>

        <template id="einv_external_layout_boxed"
                  inherit_id="web.external_layout_boxed">
<!--            <xpath expr="//ul[@name='company_address_list']" position="before">-->
<!--                <t t-call="einv_sa.einv_header_company_name"/>-->
<!--            </xpath>-->
            <xpath expr="//*[@t-field='company.report_footer']" position="before">
                <t t-call="einv_sa.financial_layout_row"/>
            </xpath>
            <xpath expr="//ul[@name='company_address_list']/li[@t-if='not forced_vat']/following-sibling::li[1]" position="replace"></xpath>
            <xpath expr="//ul[@name='company_address_list']/li[@t-if='not forced_vat']" position="replace"></xpath>
        </template>

        <template id="einv_external_layout_bold"
                  inherit_id="web.external_layout_bold">
<!--            <xpath expr="//ul[@name='company_address_list']" position="before">-->
<!--                <t t-call="einv_sa.einv_header_company_name"/>-->
<!--            </xpath>-->
            <xpath expr="//*[@t-field='company.report_footer']" position="before">
                <t t-call="einv_sa.financial_layout_row"/>
            </xpath>
        </template>

        <template id="einv_external_layout_striped"
                  inherit_id="web.external_layout_striped">
            <xpath expr="//ul[@name='company_address_list']" position="before">
                <t t-call="einv_sa.einv_header_company_name"/>
            </xpath>
            <xpath expr="//*[@t-field='company.report_footer']" position="before">
                <t t-call="einv_sa.financial_layout_row"/>
            </xpath>
        </template>
    </data>
</odoo>
