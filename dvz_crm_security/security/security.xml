<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="category_dvz_crm" model="ir.module.category">
    <field name="name">CRM</field><field name="sequence">21</field>
  </record>
  <record id="privilege_crm" model="res.groups.privilege">
    <field name="name">CRM Access</field><field name="category_id" ref="category_dvz_crm"/><field name="sequence">10</field>
  </record>
  <record id="privilege_presale" model="res.groups.privilege">
    <field name="name">Presale Access</field><field name="category_id" ref="category_dvz_crm"/><field name="sequence">20</field>
  </record>
  <record id="group_crm_head" model="res.groups">
    <field name="name">CRM Head</field><field name="privilege_id" ref="privilege_crm"/><field name="sequence">10</field>
    <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    <field name="comment">Full CRM access across all teams, including configuration and lead management.</field>
  </record>
  <record id="group_crm_team_leader" model="res.groups">
    <field name="name">CRM Team Leader</field><field name="privilege_id" ref="privilege_crm"/><field name="sequence">20</field>
    <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    <field name="comment">Can access leads for teams where this user is the team leader.</field>
  </record>
  <record id="group_crm_salesperson" model="res.groups">
    <field name="name">CRM Salesperson</field><field name="privilege_id" ref="privilege_crm"/><field name="sequence">30</field>
    <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    <field name="comment">Can access leads assigned as salesperson.</field>
  </record>
  <record id="group_presale_head" model="res.groups">
    <field name="name">Presale Head</field><field name="privilege_id" ref="privilege_presale"/><field name="sequence">10</field>
    <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    <field name="comment">Can see leads from all Presale Teams and manage Presale assignments.</field>
  </record>
  <record id="group_presale_team_leader" model="res.groups">
    <field name="name">Presale Team Leader</field><field name="privilege_id" ref="privilege_presale"/><field name="sequence">20</field>
    <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    <field name="comment">Can see leads belonging to Presale Teams they lead and assign team members.</field>
  </record>
  <record id="group_presale_member" model="res.groups">
    <field name="name">Presale Member</field><field name="privilege_id" ref="privilege_presale"/><field name="sequence">30</field>
    <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    <field name="comment">Can see only leads where they are explicitly selected in Presale.</field>
  </record>
  <record id="dvz_crm_salesperson_rule" model="ir.rule">
    <field name="name">CRM: Own salesperson leads</field><field name="model_id" ref="crm.model_crm_lead"/>
    <field name="groups" eval="[(4, ref('group_crm_salesperson'))]"/>
    <field name="domain_force">[('user_id', '=', user.id)]</field>
  </record>
  <record id="dvz_crm_team_leader_rule" model="ir.rule">
    <field name="name">CRM: Leads of teams led</field><field name="model_id" ref="crm.model_crm_lead"/>
    <field name="groups" eval="[(4, ref('group_crm_team_leader'))]"/>
    <field name="domain_force">[('team_id.user_id', '=', user.id)]</field>
  </record>
  <record id="dvz_crm_head_rule" model="ir.rule">
    <field name="name">CRM: Head all leads</field><field name="model_id" ref="crm.model_crm_lead"/>
    <field name="groups" eval="[(4, ref('group_crm_head'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
  </record>
  <record id="rule_presale_head" model="ir.rule">
    <field name="name">Presale Head: all leads</field><field name="model_id" ref="crm.model_crm_lead"/>
    <field name="groups" eval="[(4, ref('group_presale_head'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
  </record>
  <record id="rule_presale_team_leader" model="ir.rule">
    <field name="name">Presale Leader: own teams</field><field name="model_id" ref="crm.model_crm_lead"/>
    <field name="groups" eval="[(4, ref('group_presale_team_leader'))]"/>
    <field name="domain_force">[('team_id.user_id', '=', user.id)]</field>
  </record>
  <record id="rule_presale_member" model="ir.rule">
    <field name="name">Presale Member: assigned leads</field><field name="model_id" ref="crm.model_crm_lead"/>
    <field name="groups" eval="[(4, ref('group_presale_member'))]"/>
    <field name="domain_force">[('presale_member_ids', 'in', [user.id])]</field>
  </record>
</odoo>
