<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- New group: CRM Team Leader.
             Extends the native "Sales / My Pipeline" group
             (sales_team.group_sale_salesman) rather than replacing it,
             so a Team Leader keeps normal salesperson access (create/
             edit their own leads, etc.) on top of the wider visibility
             below. Deliberately does NOT imply
             sales_team.group_sale_salesman_all_leads - that would grant
             visibility into EVERY team's leads, which is reserved for
             "Head" (the native Sales Manager group), not a Team
             Leader. -->
        <record id="group_crm_team_leader" model="res.groups">
            <field name="name">CRM: Team Leader</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="comment">Sees every lead belonging to any Sales Team where they are set as that team's own Team Leader (crm.team's user_id field) - not just their own leads, but not other teams' leads either.</field>
        </record>

        <!-- The actual visibility rule: a lead is visible to this group
             if the lead's OWN Sales Team has this user set as that
             team's Team Leader. Combines via OR with the native
             Salesperson rule (their own leads) that this group also
             carries via implied_ids above - Odoo ORs together every
             rule that applies via any group a user belongs to, so a
             Team Leader ends up seeing (their own leads) OR (their
             team's leads), which is exactly the intended behavior. -->
        <record id="dvz_crm_team_leader_rule" model="ir.rule">
            <field name="name">CRM Team Leader: see own team's leads</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="groups" eval="[(4, ref('group_crm_team_leader'))]"/>
            <field name="domain_force">[('team_id.user_id', '=', user.id)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
