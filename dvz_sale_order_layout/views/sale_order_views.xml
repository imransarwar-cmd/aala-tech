<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view additions. List view changes are applied safely to the final
         combined architecture in sale.order._get_view, avoiding missing XPath anchors. -->
    <record id="sale_order_form_dvz_layout" model="ir.ui.view">
        <field name="name">sale.order.form.dvz.layout</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="inside">
                <group name="dvz_order_dates" string="Order Dates" col="2">
                    <field name="create_date" string="Creation Date" readonly="1"/>
                    <field name="date_order" string="SO Date"/>
                    <field name="validity_date" string="Expiration Date"/>
                </group>
                <group name="dvz_order_identifiers" string="Order References" col="2">
                    <field name="dvz_analytic_code_display" string="Analytic Code" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
