<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add one additional SO Date immediately after the existing Expiration Date.
         Do not create a separate Order Dates section or duplicate Creation Date. -->
    <record id="sale_order_form_dvz_layout" model="ir.ui.view">
        <field name="name">sale.order.form.dvz.layout</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="date_order" string="SO Date" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="inside">
                <group name="dvz_order_identifiers" string="Order References" col="2">
                    <field name="dvz_analytic_code_display" string="Analytic Code" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
