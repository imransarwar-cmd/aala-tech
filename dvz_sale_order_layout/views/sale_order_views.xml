<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main form: show SO Date once in the requested date sequence,
         and again immediately after Expiration Date as requested. -->
    <record id="sale_order_form_dvz_layout" model="ir.ui.view">
        <field name="name">sale.order.form.dvz.layout</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group name="dvz_order_dates_main" string="Order Dates" col="4">
                    <field name="create_date" string="Creation Date" readonly="1"/>
                    <field name="date_order" string="SO Date"/>
                    <field name="validity_date" string="Expiration Date"/>
                    <field name="date_order" string="SO Date" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="inside">
                <group name="dvz_order_identifiers" string="Order References" col="2">
                    <field name="dvz_analytic_code_display" string="Analytic Code" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
