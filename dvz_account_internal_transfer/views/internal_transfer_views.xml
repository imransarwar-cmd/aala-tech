<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_internal_transfer_list" model="ir.ui.view">
    <field name="name">account.internal.transfer.list</field><field name="model">account.internal.transfer</field>
    <field name="arch" type="xml"><list string="Internal Transfers" decoration-success="state == 'posted'" decoration-muted="state == 'reversed'">
      <field name="name"/><field name="date"/><field name="source_journal_id"/><field name="destination_journal_id"/><field name="amount"/><field name="currency_id" column_invisible="True"/><field name="state"/>
    </list></field>
  </record>
  <record id="view_internal_transfer_form" model="ir.ui.view">
    <field name="name">account.internal.transfer.form</field><field name="model">account.internal.transfer</field>
    <field name="arch" type="xml"><form string="Internal Transfer">
      <header>
        <button name="action_post" type="object" string="Post Transfer" class="btn-primary" invisible="state != 'draft'" groups="account.group_account_manager"/>
        <button name="action_reverse" type="object" string="Reverse Transfer" confirm="This creates a reversing journal entry. Continue?" invisible="state != 'posted'" groups="account.group_account_manager"/>
        <field name="state" widget="statusbar" statusbar_visible="draft,posted,reversed"/>
      </header>
      <sheet><div class="oe_button_box" name="button_box">
        <button name="action_view_entry" type="object" class="oe_stat_button" icon="fa-book" invisible="not move_id"><div class="o_stat_info"><span class="o_stat_text">Journal Entry</span></div></button>
        <button name="action_view_reversal" type="object" class="oe_stat_button" icon="fa-undo" invisible="not reversal_move_id"><div class="o_stat_info"><span class="o_stat_text">Reversal</span></div></button>
      </div><h1><field name="name" readonly="1"/></h1>
      <group><group><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
        <field name="date" readonly="state != 'draft'"/><field name="source_journal_id" readonly="state != 'draft'"/><field name="destination_journal_id" readonly="state != 'draft'"/></group>
        <group><field name="currency_id" invisible="1"/><field name="amount" readonly="state != 'draft'"/><field name="entry_journal_id" readonly="state != 'draft'"/><field name="memo" readonly="state != 'draft'"/></group></group>
      <group invisible="1"><field name="move_id"/><field name="reversal_move_id"/></group>
      </sheet><chatter/></form></field>
  </record>
  <record id="action_internal_transfers" model="ir.actions.act_window">
    <field name="name">Internal Transfers</field><field name="res_model">account.internal.transfer</field><field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_internal_transfers" name="Internal Transfers" parent="account.menu_finance" action="action_internal_transfers" sequence="45" groups="account.group_account_invoice,account.group_account_manager"/>
</odoo>
