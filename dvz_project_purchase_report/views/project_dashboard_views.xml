<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================= List: one row per project ======================= -->
    <record id="view_dvz_project_dashboard_list" model="ir.ui.view">
        <field name="name">dvz.project.dashboard.list</field>
        <field name="model">dvz.project.dashboard</field>
        <field name="arch" type="xml">
            <list string="Project Profit and Loss" create="false" edit="false" delete="false">
                <field name="analytic_account_id" string="Project"/>
                <field name="partner_id" string="Customer" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="agreed_amount" sum="Total"/>
                <field name="budget" optional="hide" sum="Total"/>
                <field name="po_commitment" sum="Total"/>
                <field name="billed_cost" sum="Total"/>
                <field name="revenue" sum="Total"/>
                <field name="expected_profit" sum="Total"
                       decoration-danger="expected_profit &lt; 0"
                       decoration-success="expected_profit &gt; 0"/>
                <field name="expected_margin"
                       decoration-danger="expected_margin &lt; 0"
                       decoration-success="expected_margin &gt; 0"/>
                <field name="profit" sum="Total" optional="show"
                       decoration-danger="profit &lt; 0"
                       decoration-success="profit &gt; 0"/>
                <field name="margin_percent" optional="show"
                       decoration-danger="margin_percent &lt; 0"
                       decoration-success="margin_percent &gt; 0"/>
                <field name="invoiced_percent" optional="hide"/>
                <field name="still_to_bill" optional="hide" sum="Total"/>
                <field name="draft_bills" optional="hide" sum="Total"/>
                <field name="to_invoice" optional="hide" sum="Total"/>
                <field name="planned_profit" optional="hide" sum="Total"/>
                <field name="planned_margin" optional="hide"/>
                <field name="budget_remaining" optional="hide"
                       decoration-danger="budget_remaining &lt; 0"/>
                <field name="budget_used_percent" widget="progressbar" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ======================= Form: the project's one-page P&L ======================= -->
    <record id="view_dvz_project_dashboard_form" model="ir.ui.view">
        <field name="name">dvz.project.dashboard.form</field>
        <field name="model">dvz.project.dashboard</field>
        <field name="arch" type="xml">
            <form string="Project Profit and Loss" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_analytic_account" type="object"
                            string="Set Project Budget" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_sale_orders" type="object" class="oe_stat_button" icon="fa-handshake-o">
                            <field name="so_count" widget="statinfo" string="Sale Orders"/>
                        </button>
                        <button name="action_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="po_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                        <button name="action_bills" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <field name="bill_count" widget="statinfo" string="Vendor Bills"/>
                        </button>
                        <button name="action_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="analytic_account_id" readonly="1"/></h1>
                        <h3 class="text-muted">
                            <field name="partner_id" readonly="1" placeholder="No customer set"/>
                        </h3>
                    </div>

                    <group>
                        <group string="1. Contract (agreed with the client)">
                            <field name="agreed_amount"/>
                            <field name="revenue"/>
                            <field name="to_invoice"/>
                            <field name="invoiced_percent" widget="progressbar"/>
                        </group>
                        <group string="2. Cost (what you pay suppliers)">
                            <field name="budget"/>
                            <field name="po_commitment"/>
                            <field name="billed_cost"/>
                            <field name="still_to_bill"/>
                            <field name="draft_bills"/>
                        </group>
                    </group>

                    <group>
                        <group string="3. Expected result (agreed - committed)">
                            <field name="expected_profit"
                                   decoration-danger="expected_profit &lt; 0"
                                   decoration-success="expected_profit &gt; 0"/>
                            <field name="expected_margin"
                                   decoration-danger="expected_margin &lt; 0"
                                   decoration-success="expected_margin &gt; 0"/>
                        </group>
                        <group string="4. Actual result so far (invoiced - billed)">
                            <field name="profit"
                                   decoration-danger="profit &lt; 0"
                                   decoration-success="profit &gt; 0"/>
                            <field name="margin_percent"
                                   decoration-danger="margin_percent &lt; 0"
                                   decoration-success="margin_percent &gt; 0"/>
                        </group>
                    </group>

                    <group>
                        <group string="5. Plan vs budget (needs a budget)">
                            <field name="planned_profit"/>
                            <field name="planned_margin"/>
                        </group>
                        <group string="6. Budget control">
                            <field name="budget_remaining"
                                   decoration-danger="budget_remaining &lt; 0"/>
                            <field name="budget_used_percent" widget="progressbar"/>
                        </group>
                    </group>

                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>

                    <div class="text-muted small">
                        All amounts are untaxed and in company currency. Agreed price = confirmed sale orders;
                        committed = confirmed purchase orders; billed and invoiced count posted documents only
                        (credit notes subtract). Costs not on a vendor bill (labour, stock consumption, overhead)
                        are not included. Budget is typed on the analytic account.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dvz_project_dashboard_search" model="ir.ui.view">
        <field name="name">dvz.project.dashboard.search</field>
        <field name="model">dvz.project.dashboard</field>
        <field name="arch" type="xml">
            <search string="Project Profit and Loss">
                <field name="analytic_account_id" string="Project"/>
                <field name="partner_id" string="Customer"/>
                <field name="plan_id"/>
                <field name="company_id"/>
                <filter string="Expected loss" name="expected_loss" domain="[('expected_profit', '&lt;', 0)]"/>
                <filter string="Actual loss so far" name="actual_loss" domain="[('profit', '&lt;', 0)]"/>
                <filter string="Over budget" name="over_budget" domain="[('budget_remaining', '&lt;', 0)]"/>
                <separator/>
                <filter string="Has agreed price" name="has_agreed" domain="[('agreed_amount', '&gt;', 0)]"/>
                <filter string="No sale order yet" name="no_agreed" domain="[('agreed_amount', '=', 0)]"/>
                <filter string="Has budget" name="has_budget" domain="[('budget', '&gt;', 0)]"/>
                <filter string="No budget set" name="no_budget" domain="[('budget', '=', 0)]"/>
                <separator/>
                <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_dvz_project_dashboard_pivot" model="ir.ui.view">
        <field name="name">dvz.project.dashboard.pivot</field>
        <field name="model">dvz.project.dashboard</field>
        <field name="arch" type="xml">
            <pivot string="Project Profit and Loss">
                <field name="analytic_account_id" type="row"/>
                <field name="agreed_amount" type="measure"/>
                <field name="po_commitment" type="measure"/>
                <field name="billed_cost" type="measure"/>
                <field name="revenue" type="measure"/>
                <field name="expected_profit" type="measure"/>
                <field name="profit" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dvz_project_dashboard_graph" model="ir.ui.view">
        <field name="name">dvz.project.dashboard.graph</field>
        <field name="model">dvz.project.dashboard</field>
        <field name="arch" type="xml">
            <graph string="Project Profit and Loss" type="bar">
                <field name="analytic_account_id"/>
                <field name="expected_profit" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_dvz_project_dashboard" model="ir.actions.act_window">
        <field name="name">Project Profit &amp; Loss</field>
        <field name="res_model">dvz.project.dashboard</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_dvz_project_dashboard_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No project figures yet</p>
            <p>Put the project (analytic account) on your sale order lines, purchase order lines
               and bills. Each project then shows its agreed price, cost, profit and margin here.</p>
        </field>
    </record>

    <menuitem id="menu_dvz_project_dashboard" name="Project Profit &amp; Loss"
              parent="menu_dvz_project_purchase_root" action="action_dvz_project_dashboard" sequence="1"/>

</odoo>
