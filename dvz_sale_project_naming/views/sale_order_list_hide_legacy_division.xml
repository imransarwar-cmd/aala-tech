<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Hide the legacy aala_rest_api many2many Division column and the
        duplicate dvz_division_id column labelled Division before user_id.
        Keep the Department-labelled dvz_division_id column and all data.
    -->
    <record id="sale_order_tree_hide_legacy_division" model="ir.ui.view">
        <field name="name">sale.order.tree.hide.legacy.division</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='aala_division_ids']" position="replace"/>
            <!-- Hide only the duplicate Division-labelled dvz_division_id
                 that appears before user_id. Keep the Department column. -->
            <xpath expr="//list/field[@name='dvz_division_id' and @string='Division' and following-sibling::field[@name='user_id']]"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
