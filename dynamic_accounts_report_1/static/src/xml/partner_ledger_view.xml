<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!--
    The pl_template_new template for the PartnerLedger component.
    @param {Object} state - The state object containing the component's state data.
    -->
    <t t-name="pl_template_new" owl="1">
        <div class="container-fluid">
            <div class="fin_report">
                <!-- Filter View -->
                <div class="filter_view_pl pt-3 pb-5">
                    <!-- Title -->
                    <div class="">
                        <h2 class="text-uppercase" style="padding:10px">
                            <t t-esc="props.action.name"/>
                        </h2>
                    </div>
                    <div style="margin-right: 10px; margin-left: 10px;margin-bottom: 15px;display: flex;justify-content: space-between;flex-wrap:wrap;">
                        <div class="sub_container_left">
                            <div class="report_print">
                                <!-- Print (PDF) Button -->
                                <button type="button"
                                        class="btn btn-primary btn-report-print"
                                        t-on-click="printPdf"
                                        style="margin-right: 8px;">
                                    Print (PDF)
                                </button>
                                <!-- Export (XLSX) Button -->
                                <button type="button"
                                        class="btn btn-primary btn-report-print"
                                        t-on-click="print_xlsx">
                                    Export (XLSX)
                                </button>
                            </div>
                        </div>
                        <div class="dvz_filter_grid" style="display:grid;grid-template-columns:repeat(2, auto);column-gap:32px;row-gap:8px;">

                            <!-- Row 1: Date Range | Partners -->
                            <div class="dvz_filter_row">
                                <span class="fa fa-calendar me-1"/>
                                <a type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                                    Date Range
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <div class="list-group">
                                        <button class="report-filter-button" t-att-data-value="'month'" type="button" t-on-click="applyFilter">This Month</button>
                                        <button class="report-filter-button" t-att-data-value="'quarter'" type="button" t-on-click="applyFilter">This Quarter</button>
                                        <button class="report-filter-button" t-att-data-value="'year'" type="button" t-on-click="applyFilter">This Year</button>
                                        <div role="separator" class="dropdown-divider"/>
                                        <button class="report-filter-button" t-att-data-value="'last-month'" type="button" t-on-click="applyFilter">Last month</button>
                                        <button class="report-filter-button" t-att-data-value="'last-quarter'" type="button" t-on-click="applyFilter">Last quarter</button>
                                        <button class="report-filter-button" t-att-data-value="'last-year'" type="button" t-on-click="applyFilter">Last year</button>
                                        <div role="separator" class="dropdown-divider"/>
                                        <label for="date_from">Start Date :</label>
                                        <div class="input-group date" t-ref="date_from" data-target-input="nearest">
                                            <input type="date" id="start_date" t-on-change="applyFilter"
                                                   style="border:none;border-bottom: 1px solid #000;padding: 5px;outline: none;"
                                                   name="start_date"/>
                                        </div>
                                        <label for="date_to">End Date :</label>
                                        <div class="input-group date" t-ref="date_to" data-target-input="nearest">
                                            <input type="date" id="end_date" t-on-change="applyFilter"
                                                   style="border:none;border-bottom: 1px solid #000;padding: 5px;outline: none;"
                                                   name="end_date"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="dvz_filter_row">
                                <span class="fa fa-users me-1"/>
                                <a type="button" class="dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                    Partners:
                                    <t t-if="state.selected_partner and state.selected_partner.length">
                                        <t t-esc="state.selected_partner.length"/> selected
                                    </t>
                                </a>
                                <div class="dropdown-menu p-2" role="menu" style="min-width:280px;">
                                    <input type="text" class="form-control mb-2" placeholder="Search partners..." t-on-input="onPartnerSearchInput"/>
                                    <div style="max-height:220px;overflow-y:auto;">
                                        <t t-foreach="state.partner_search_results" t-as="p" t-key="p.id">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input"
                                                       t-att-id="'dvz_partner_' + p.id"
                                                       t-att-checked="state.selected_partner and state.selected_partner.includes(p.id)"
                                                       t-on-change="() => this.onPartnerCheckToggle(p.id)"/>
                                                <label class="form-check-label" t-att-for="'dvz_partner_' + p.id">
                                                    <t t-esc="p.name"/>
                                                </label>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="dropdown-divider"/>
                                    <button class="btn btn-sm btn-secondary me-2" type="button" t-on-click="clearPartnerFilter">Clear</button>
                                    <button class="btn btn-sm btn-primary" type="button" t-on-click="applyPartnerFilter">Apply</button>
                                </div>
                            </div>

                            <!-- Row 2: Account Type | Options -->
                            <div class="dvz_filter_row">
                                <span class="fa fa-user me-1"/>
                                <a type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                                    Account Type
                                    <t t-if="state.account">:
                                        <t t-foreach="state.account" t-as="account_key" t-key="account_key_index">
                                            <t t-esc="account_key"/>
                                            <t t-if="account_key_index != Object.keys(state.account).length - 1">,</t>
                                        </t>
                                    </t>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <div class="list-group">
                                        <button class="report-filter-button" t-att-data-value="'receivable'" type="button" t-on-click="applyFilter">Receivable</button>
                                        <button class="report-filter-button" t-att-data-value="'payable'" type="button" t-on-click="applyFilter">Payable</button>
                                    </div>
                                </div>
                            </div>

                            <div class="dvz_filter_row">
                                <span class="fa fa-filter me-1"/>
                                <a type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                                    Options : Posted Entries
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <div class="list-group">
                                        <button class="report-filter-button" t-att-data-value="'draft'" type="button" t-on-click="applyFilter">Include Draft Entries</button>
                                        <button class="report-filter-button" type="button" t-ref="unfoldButton" t-on-click="unfoldAll">Unfold All</button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <br/>
            <div style="margin-left:10px;margin-bottom:10px;max-width:300px;">
                <input type="text"
                       class="form-control"
                       placeholder="Filter rows..."
                       t-on-input="onRowSearchInput"/>
            </div>
            <div class="table_style" style="height: 650px; overflow-y: scroll;">
                <div class="table_view_pl" style="right:20px;width:100%;"
                     t-ref="table_view_pl">
                    <div>
                        <div class="table_main_view">
                            <!-- Table View -->
                            <table cellspacing="0" width="100%">
                                <!-- Table Header -->
                                <thead>
                                    <tr class="o_heading">
                                        <th style="width:20px;"/>
                                        <th>Partner</th>
                                        <th class="text-end">Debit</th>
                                        <th class="text-end">Credit</th>
                                        <th class="text-end">Balance</th>
                                    </tr>
                                </thead>
                                <!-- Table Body -->
                                <tbody t-ref="tbody">
                                    <!-- Summary row per partner, with an expandable detail
                                         section underneath showing every transaction line -
                                         matching Odoo 16's caret-toggle behavior. -->
                                    <t t-if="state.partners">
                                        <t t-set="i" t-value="0"/>
                                        <t t-foreach="getFilteredPartners()"
                                           t-as="partner"
                                           t-key="partner_index">
                                            <t t-set="i" t-value="i + 1"/>
                                            <tr class="border-bottom border-dark border-gainsboro">
                                                <td>
                                                    <span class="toggle-icon"
                                                          data-bs-toggle="collapse"
                                                          t-attf-href="#dvz-partner-{{i}}"
                                                          aria-expanded="false"
                                                          t-attf-aria-controls="dvz-partner-{{i}}"
                                                          style="cursor:pointer;">
                                                        <i class="fa fa-caret-down"/>
                                                    </span>
                                                </td>
                                                <th>
                                                    <a class="btn header o_heading"
                                                       t-att-data-id="state.total[partner]['partner_id']"
                                                       t-on-click="openPartner">
                                                        <t t-if="partner != 'false'">
                                                            <t t-esc="partner"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span>Unknown Partner</span>
                                                        </t>
                                                    </a>
                                                </th>
                                                <th class="text-end">
                                                    <span>
                                                        <t t-if="state.total[partner]['total_debit']"
                                                           t-esc="state.total[partner]['currency_id']"/>
                                                        <t t-if="state.total[partner]['total_debit']"
                                                           t-esc="state.total[partner]['total_debit']"/>
                                                    </span>
                                                </th>
                                                <th class="text-end">
                                                    <span>
                                                        <t t-if="state.total[partner]['total_credit']"
                                                           t-esc="state.total[partner]['currency_id']"/>
                                                        <t t-if="state.total[partner]['total_credit']"
                                                           t-esc="state.total[partner]['total_credit']"/>
                                                    </span>
                                                </th>
                                                <th class="text-end">
                                                    <span class="fw-bolder">
                                                        <t t-esc="state.total[partner]['currency_id']"/>
                                                        <t t-esc="(state.total[partner]['total_debit'] - state.total[partner]['total_credit']).toFixed(2)"/>
                                                    </span>
                                                </th>
                                            </tr>
                                            <!-- Collapsible detail section - hidden by default,
                                                 shown when the caret is clicked. -->
                                            <tr t-attf-class="collapse" t-attf-id="dvz-partner-{{i}}">
                                                <td colspan="5" style="padding:0;">
                                                    <table class="table table-sm mb-0" width="100%">
                                                        <thead>
                                                            <tr style="background:#f0f0f0;">
                                                                <th>Date</th>
                                                                <th>JRNL</th>
                                                                <th>Account</th>
                                                                <th>Ref</th>
                                                                <th>Due Date</th>
                                                                <th>Matching Number</th>
                                                                <th class="text-end">Debit</th>
                                                                <th class="text-end">Credit</th>
                                                                <th class="text-end">Amount Currency</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <t t-foreach="state.data[partner]"
                                                               t-as="valuelist"
                                                               t-key="valuelist_index">
                                                                <tr>
                                                                    <td><t t-esc="valuelist[0]['date']"/></td>
                                                                    <td><t t-esc="valuelist[0]['jrnl']"/></td>
                                                                    <td><t t-esc="valuelist[0]['code']"/></td>
                                                                    <td>
                                                                        <t t-if="valuelist[0]['move_name']">
                                                                            <a href="#"
                                                                               style="text-decoration:underline;cursor:pointer;"
                                                                               t-att-data-id="valuelist[0]['move_id'][0]"
                                                                               t-on-click="gotoJournalEntry"
                                                                               t-esc="valuelist[0]['move_name']"/>
                                                                        </t>
                                                                    </td>
                                                                    <td>
                                                                        <t t-if="valuelist[0]['date_maturity']"
                                                                           t-esc="valuelist[0]['date_maturity']"/>
                                                                    </td>
                                                                    <td>
                                                                        <t t-if="valuelist[0]['matching_number']"
                                                                           t-esc="valuelist[0]['matching_number']"/>
                                                                    </td>
                                                                    <td class="text-end">
                                                                        <t t-if="valuelist[0]['debit']"
                                                                           t-esc="state.total[partner]['currency_id']"/>
                                                                        <t t-if="valuelist[0]['debit']"
                                                                           t-esc="valuelist[0]['debit']"/>
                                                                    </td>
                                                                    <td class="text-end">
                                                                        <t t-if="valuelist[0]['credit']"
                                                                           t-esc="state.total[partner]['currency_id']"/>
                                                                        <t t-if="valuelist[0]['credit']"
                                                                           t-esc="valuelist[0]['credit']"/>
                                                                    </td>
                                                                    <td class="text-end">
                                                                        <t t-if="valuelist[0]['amount_currency']"
                                                                           t-esc="state.total[partner]['currency_id']"/>
                                                                        <t t-if="valuelist[0]['amount_currency']"
                                                                           t-esc="valuelist[0]['amount_currency']"/>
                                                                    </td>
                                                                </tr>
                                                            </t>
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="foot_note">
                <t t-set="count" t-value="1"/>
                <t t-foreach="state.message_list" t-as="message"
                   t-key="message_index">
                    <t t-out="count"/>.
                    <t t-set="count" t-value="count + 1"/>
                    <t t-out="message['message']"/>
                    <i t-att-id="message['id']" style="margin-left: 1%;"
                       class="fa fa-trash"
                       t-on-click="deleteNote"/>
                    <br/>
                </t>
            </div>
        </div>
    </t>
</templates>
