<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- System Master Views -->
    <record id="view_system_master_tree" model="ir.ui.view">
        <field name="name">system.master.tree</field>
        <field name="model">system.master</field>
        <field name="arch" type="xml">
            <list string="System Masters">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_system_master_form" model="ir.ui.view">
        <field name="name">system.master.form</field>
        <field name="model">system.master</field>
        <field name="arch" type="xml">
            <form string="System Master">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="division"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="url"/>
                            <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                        <field name="banner_image" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_system_master" model="ir.actions.act_window">
        <field name="name">System Masters</field>
        <field name="res_model">system.master</field>
        <field name="view_mode">list,form</field>
    </record>

