<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manual_reservation_request_list" model="ir.ui.view">
        <field name="name">dvz.manual.reservation.request.list</field>
        <field name="model">dvz.manual.reservation.request</field>
        <field name="arch" type="xml">
            <list string="Manual Reservations" default_order="id desc" decoration-muted="state == 'cancel'">
                <field name="name" string="Reservation"/>
                <field name="partner_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="sale_order_id" string="SO Number" optional="hide"/>
                <field name="date" optional="show"/>
                <field name="picking_id" string="Transfer" optional="hide"/>
                <field name="reservation_status" widget="badge" optional="show"
                       decoration-success="reservation_status in ('reserved', 'delivered')"
                       decoration-warning="reservation_status in ('waiting', 'partial')"
                       decoration-muted="reservation_status in ('draft', 'cancel')"/>
                <field name="state" widget="badge" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_manual_reservation_request_form" model="ir.ui.view">
        <field name="name">dvz.manual.reservation.request.form</field>
        <field name="model">dvz.manual.reservation.request</field>
        <field name="arch" type="xml">
            <form string="Manual Material Reservation">
                <header>
                    <button name="action_confirm" type="object" string="Confirm &amp; Reserve"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reserve" type="object" string="Check Availability"
                            invisible="state != 'confirmed' or reservation_status in ('delivered', 'cancel')"/>
                    <button name="action_unreserve" type="object" string="Unreserve"
                            invisible="state != 'confirmed' or reservation_status not in ('reserved', 'partial')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancel' or reservation_status == 'delivered'"
                            confirm="Cancel this request and its pending transfer?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button"
                                icon="fa-truck" invisible="not picking_count">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                        <button name="action_view_report" type="object" class="oe_stat_button" icon="fa-list">
                            <div class="o_stat_info"><span class="o_stat_text">Product Report</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'" required="not project_id"/>
                            <field name="project_id" readonly="state != 'draft'" required="not partner_id"
                                   options="{'no_create': True}"/>
                            <field name="sale_order_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="picking_type_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="location_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="reservation_status" widget="badge" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" default_order="sequence, id">
                            <field name="sequence" widget="handle"/>
                            <field name="company_id" column_invisible="1"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="requested_qty"/>
                            <field name="product_uom_id" readonly="1" options="{'no_open': True}"/>
                            <field name="reserved_qty" readonly="1" optional="show"/>
                            <field name="remaining_qty" readonly="1" optional="show"/>
                            <field name="delivered_qty" readonly="1" optional="hide"/>
                        </list>
                    </field>
                    <field name="notes" placeholder="Notes..." readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_manual_reservation_request_search" model="ir.ui.view">
        <field name="name">dvz.manual.reservation.request.search</field>
        <field name="model">dvz.manual.reservation.request</field>
        <field name="arch" type="xml">
            <search string="Manual Reservations">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="sale_order_id" string="SO Number"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="shortage" string="Waiting / Partial" domain="[('reservation_status', 'in', ['waiting', 'partial'])]"/>
                <group>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'reservation_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_manual_reservation_line_list" model="ir.ui.view">
        <field name="name">dvz.manual.reservation.request.line.list</field>
        <field name="model">dvz.manual.reservation.request.line</field>
        <field name="arch" type="xml">
            <list string="Manual Reservation Report" create="0" edit="0" delete="0" duplicate="0" import="0">
                <field name="request_id" string="Reservation"/>
                <field name="partner_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="sale_order_id" optional="hide"/>
                <field name="product_id"/>
                <field name="requested_qty" optional="show"/>
                <field name="reserved_qty" optional="show"/>
                <field name="remaining_qty" optional="show"/>
                <field name="delivered_qty" optional="hide"/>
                <field name="product_uom_id" optional="show"/>
                <field name="date" optional="hide"/>
                <field name="state" widget="badge" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_manual_reservation_line_form" model="ir.ui.view">
        <field name="name">dvz.manual.reservation.request.line.form</field>
        <field name="model">dvz.manual.reservation.request.line</field>
        <field name="arch" type="xml">
            <form string="Reserved Material" create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                        </group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="requested_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="reserved_qty" readonly="1"/>
                            <field name="delivered_qty" readonly="1"/>
                            <field name="remaining_qty" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_manual_reservation_line_search" model="ir.ui.view">
        <field name="name">dvz.manual.reservation.request.line.search</field>
        <field name="model">dvz.manual.reservation.request.line</field>
        <field name="arch" type="xml">
            <search string="Manual Reservation Report">
                <field name="request_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="sale_order_id"/>
                <filter name="confirmed" string="Confirmed Requests" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="reserved" string="Reserved Stock" domain="[('reserved_qty', '&gt;', 0)]"/>
                <filter name="shortage" string="To Reserve" domain="[('remaining_qty', '&gt;', 0)]"/>
                <group>
                    <filter name="group_request" string="Reservation" context="{'group_by': 'request_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_order" string="SO Number" context="{'group_by': 'sale_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_manual_reservation_requests" model="ir.actions.act_window">
        <field name="name">Manual Reservations</field>
        <field name="res_model">dvz.manual.reservation.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_manual_reservation_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a manual reservation</p>
            <p>Select a customer or project, add materials, and confirm to reserve available stock.</p>
        </field>
    </record>
    <record id="action_manual_reservation_lines" model="ir.actions.act_window">
        <field name="name">Manual Reservation Report</field>
        <field name="res_model">dvz.manual.reservation.request.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_manual_reservation_line_list"/>
        <field name="search_view_id" ref="view_manual_reservation_line_search"/>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>

    <menuitem id="menu_manual_reservation_requests" name="Manual Reservations"
              parent="stock.menu_stock_warehouse_mgmt" action="action_manual_reservation_requests"
              groups="stock.group_stock_user" sequence="35"/>
    <menuitem id="menu_manual_reservation_lines" name="Manual Reservation Report"
              parent="stock.menu_stock_warehouse_mgmt" action="action_manual_reservation_lines"
              groups="stock.group_stock_user" sequence="36"/>
</odoo>
