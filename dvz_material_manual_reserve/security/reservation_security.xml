<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_manual_reservation_company" model="ir.rule">
        <field name="name">Manual reservations: active companies</field>
        <field name="model_id" ref="model_dvz_manual_reservation_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_manual_reservation_line_company" model="ir.rule">
        <field name="name">Manual reservation lines: active companies</field>
        <field name="model_id" ref="model_dvz_manual_reservation_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
