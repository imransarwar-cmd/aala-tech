<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reservation_line_add_refs" model="ir.ui.view">
        <field name="name">stock.move.line.dvz.project.so.list</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="dvz_material_reservation_view.view_material_reservation_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="dvz_reservation_so_id" string="SO Number" readonly="1" optional="show"/>
                <field name="dvz_reservation_project_id" string="Project" readonly="1" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='picking_partner_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_reservation_form_add_refs" model="ir.ui.view">
        <field name="name">stock.move.line.dvz.project.so.form</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="dvz_material_reservation_view.view_material_reservation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_id']" position="after">
                <field name="dvz_reservation_so_id" string="SO Number" readonly="1"/>
                <field name="dvz_reservation_project_id" string="Project" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
