<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="dvz_sale_order_invoice_smart_button" model="ir.ui.view">
    <field name="name">sale.order.form.dvz.invoice.smart.button</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <field name="dvz_linked_invoice_ids" invisible="1"/>
      </xpath>
    </field>
    <field name="active" eval="False"/>
  </record>
</odoo>
