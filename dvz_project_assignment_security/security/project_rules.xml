  <record id="rule_project_read_guard" model="ir.rule">
    <field name="name">DVZ: Project: assigned project or parent of own task (guard)</field>
    <field name="model_id" ref="project.model_project_project"/>
    <field name="domain_force">user._dvz_assignment_rule_domain('project_read', company_ids)</field>
