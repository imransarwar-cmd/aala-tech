<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dvz_sale_supply_source_wizard_form" model="ir.ui.view">
        <field name="name">dvz.sale.supply.source.wizard.form</field>
        <field name="model">dvz.sale.supply.source.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Source Split">
                <div class="alert alert-info" role="alert">
                    Record the supply split in the sales line unit. For 8 required, use Stock 6 and Purchase 2.
                    Enter delivered quantities only after the delivery is completed.
                    These entries document the source; inventory reservations and purchase orders are managed in their normal screens.
                </div>
                <group>
                    <group>
                        <field name="sale_line_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="order_id"/>
                        <field name="product_id"/>
                        <field name="product_uom_id"/>
                    </group>
                    <group>
                        <field name="ordered_qty"/>
                        <field name="delivered_qty"/>
                    </group>
                </group>
                <group>
                    <group string="Total Supply (includes delivered)">
                        <field name="stock_qty"/>
                        <field name="purchase_qty"/>
                    </group>
                    <group string="Already Delivered (net of returns)">
                        <field name="stock_used_qty"/>
                        <field name="purchase_used_qty"/>
                    </group>
                </group>
                <group>
                    <field name="purchase_line_ids" widget="many2many_tags"
                           groups="purchase.group_purchase_user"
                           domain="[('product_id', '=', product_id), ('company_id', '=', company_id), ('state', 'in', ['purchase', 'done'])]"
                           options="{'no_create': True}"/>
                    <field name="note" placeholder="Example: 6 units issued from opening stock; 2 supplied against PO..."/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Save Source Split" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_dvz_sale_supply_source_wizard" model="ir.actions.act_window">
        <field name="name">Set Source Split</field>
        <field name="res_model">dvz.sale.supply.source.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dvz_sale_supply_source_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
