<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_dvz_supply" model="ir.ui.view">
        <field name="name">sale.order.form.dvz.supply.report</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dvz_supply_report" type="object" class="oe_stat_button"
                        icon="fa-list-alt" groups="sales_team.group_sale_salesman">
                    <div class="o_stat_info"><span class="o_stat_text">Stock / Purchase</span><span class="o_stat_text">Report</span></div>
                </button>
                <button name="action_dvz_supply_export" type="object" class="oe_stat_button"
                        icon="fa-file-excel-o" groups="sales_team.group_sale_salesman">
                    <div class="o_stat_info"><span class="o_stat_text">Supply Excel</span></div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
