<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Page-numbering fix for the bold layout: v19's external_layout_bold
       footer renders page numbers as a single span, not the old
       li.list-inline-item list. -->
  <template id="delivery_slip_external_layout_bold" inherit_id="web.external_layout_bold">
     <xpath expr="//span[contains(@t-if, 'pdf') and not(contains(@t-if, 'display_name_in_footer'))]" position="replace">
        <span t-if="report_type == 'pdf'" t-attf-class="text-muted {{'text-nowrap' if is_html_empty(company.report_header) else ''}}"><strong><span class="page"/>/<span class="topage"/></strong></span>
     </xpath>
     <xpath expr="//t[@t-call='web.address_layout']" position="before">
        <div t-if="o and o._name=='stock.picking'" style="margin-top:5px;">
            <h2 style="text-align:center;" t-if="o.picking_type_id.code=='outgoing'">DELIVERY NOTE</h2>
            <h2 style="text-align:center;" t-elif="o.picking_type_id.code=='incoming'">RECEIPT</h2>
        </div>
     </xpath>
  </template>

  <template id="delivery_slip_external_layout_standard" inherit_id="web.external_layout_standard">
     <xpath expr="//t[@t-call='web.address_layout']" position="before">
        <div t-if="o and o._name=='stock.picking'" style="margin-top:5px;">
            <h2 style="text-align:center;" t-if="o.picking_type_id.code=='outgoing'">DELIVERY NOTE</h2>
            <h2 style="text-align:center;" t-elif="o.picking_type_id.code=='incoming'">RECEIPT</h2>
        </div>
     </xpath>
  </template>

  <template id="delivery_slip_external_layout_boxed" inherit_id="web.external_layout_boxed">
     <xpath expr="//t[@t-call='web.address_layout']" position="before">
        <div t-if="o and o._name=='stock.picking'" style="margin-top:5px;">
            <h2 style="text-align:center;" t-if="o.picking_type_id.code=='outgoing'">DELIVERY NOTE</h2>
            <h2 style="text-align:center;" t-elif="o.picking_type_id.code=='incoming'">RECEIPT</h2>
        </div>
     </xpath>
  </template>

  <template id="report_delivery_document_inherit" inherit_id="stock.report_delivery_document">

      <!-- Title: core prints its own title via
           o.picking_type_id._get_code_report_name() inside this <h2>, in
           normal body flow. We replace its content with literal
           "DELIVERY NOTE" / "RECEIPT" wording (matching the reference
           PDF) instead of injecting a second title into the fixed
           print-header region - that region has a limited reserved
           height and was silently clipping the injected title, which is
           why it kept disappearing. Keeping this in the body avoids that
           entirely. -->
      <xpath expr="//h2[@style='margin-top: 15px;']" position="replace"></xpath>

      <!-- Two-column address block, always visible on both sides
           regardless of core's should_print_delivery_address() condition
           (that condition was hiding the left side entirely on some
           pickings). LEFT = Customer Address (order partner),
           RIGHT = Delivery Address (recipient, falling back to the
           warehouse address if no specific recipient partner is set). -->
      <xpath expr="//t[@t-set='address']" position="replace">
          <t t-set="address">
              <strong class="d-block">Delivery Address</strong>
              <t t-if="partner">
                  <div t-field="partner.commercial_partner_id"
                       t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
              </t>
              <t t-elif="o.picking_type_id and o.picking_type_id.warehouse_id">
                  <span t-field="o.picking_type_id.warehouse_id.name"/>
                  <div t-field="o.picking_type_id.warehouse_id.partner_id"
                       t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": True, "phone_icons": True}'/>
              </t>
          </t>
      </xpath>

      <xpath expr="//t[@t-set='information_block']" position="replace">
          <t t-set="information_block">
              <strong class="d-block" style="color:#1A5CA8;">
                  <span t-field="o.name"/>
              </strong>
              <strong class="d-block">Customer Address</strong>
              <div t-field="o.partner_id"
                   t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
          </t>
      </xpath>

      <xpath expr="//div[@name='div_sched_date']" position="replace">
           <div t-if="o.state" class="col col-3 mw-100 mb-2" name="div_sched_date">
                <strong>Shipping Date:</strong>
                <t t-if="o.state == 'done'">
                    <p t-esc="o.date_done.strftime('%d-%m-%Y')"/>
                </t>
                <t t-if="o.state != 'done'">
                    <p t-esc="o.scheduled_date.strftime('%d-%m-%Y')"/>
               </t>
           </div>
      </xpath>

      <!-- Line items table: replace the state!=done table with SR#/Part No/
           Description/Qty and drop its state restriction so it always
           renders; remove the done-state table entirely to avoid an
           orphaned t-elif and duplicate tables. -->
      <xpath expr="//table[@name='stock_move_table']" position="replace">
        <table class="" width="100%" name="stock_move_table">
            <thead>
                <tr>
                    <th name="th_sm_sr_no" style="width:5%;"><strong>SR#</strong></th>
                    <th name="th_sm_product"><strong>Part No</strong></th>
                    <th name="th_sm_desc"><strong>Description</strong></th>
                    <th name="th_sm_quantity"><strong>Qty</strong></th>
                </tr>
            </thead>
            <tbody>
                <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                <t t-set="i" t-value="0"/>
                <tr t-foreach="lines" t-as="move" style="border-bottom:1px solid;">
                    <t t-set="i" t-value="i+1"/>
                    <td><t t-esc="i"/></td>
                    <td><span t-field="move.product_id.default_code"/></td>
                    <td><span t-field="move.description_picking"/></td>
                    <td>
                        <span t-field="move.quantity"/>
                        <span t-field="move.product_uom"/>
                    </td>
                </tr>
            </tbody>
        </table>
      </xpath>
      <xpath expr="//table[@name='stock_move_table']" position="after">
          <div t-if="o.backorder_ids" style="margin-top:15px;">
              <div>Remaining quantities not yet delivered:</div>
              <table class="" width="100%" name="stock_move_table_remaining">
                  <thead>
                      <tr>
                          <th name="th_remaining_product" style="text-align:left;"><strong>PRODUCT</strong></th>
                          <th name="th_remaining_qty" style="text-align:right;"><strong>QUANTITY</strong></th>
                      </tr>
                  </thead>
                  <tbody>
                      <t t-foreach="o.backorder_ids.move_ids" t-as="bo_move">
                          <tr style="border-bottom:1px solid;">
                              <td><span t-field="bo_move.product_id.display_name"/></td>
                              <td style="text-align:right;">
                                  <span t-field="bo_move.product_uom_qty"/>
                                  <span t-field="bo_move.product_uom"/>
                              </td>
                          </tr>
                      </t>
                  </tbody>
              </table>
          </div>
      </xpath>
      <xpath expr="//table[@name='stock_move_line_table']" position="replace"></xpath>

      <!-- Signature block: v19 restructured the backorder section into a
           <div t-if>/<div t-else> pair, so there's no single node to
           "replace" anymore. Insert the custom signature table before
           core's own e-signature block instead - it then always appears
           after the backorder table regardless of which branch rendered. -->
      <xpath expr="//div[@t-if='not o.signature']" position="before">
              <div class="pt-4"><u>NOTE:</u></div>
              <div>In case of any shortage or damage, written notice must be given within 24 hours of receipt of goods.</div>
              <div>
                  <table width="100%">
                      <tr>
                          <th style="text-align:center;border:1px solid;">DELIVERED BY:</th>
                          <th style="text-align:center;border:1px solid;">RECEIVED BY:</th>
                      </tr>
                      <tr>
                          <td style="border:1px solid;">
                              <table width="90%">
                                  <tr>
                                      <td style="text-align:right;border:none;" width="30%">SIGNATURE:</td>
                                      <td style="border-bottom:1px solid;" width="60%"/>
                                  </tr>
                                  <tr>
                                      <td style="text-align:right;border:none;">NAME:</td>
                                      <td style="border-bottom:1px solid;"/>
                                  </tr>
                                  <tr>
                                      <td style="text-align:right;border:none;">DATE:</td>
                                      <td style="border-bottom:1px solid;"/>
                                  </tr>
                              </table>
                          </td>
                          <td style="border:1px solid;">
                                <table width="90%">
                                  <tr>
                                      <td style="text-align:right;border:none;" width="30%">SIGNATURE:</td>
                                      <td style="border-bottom:1px solid;" width="60%"/>
                                  </tr>
                                  <tr>
                                      <td style="text-align:right;border:none;">NAME:</td>
                                      <td style="border-bottom:1px solid;"/>
                                  </tr>
                                  <tr>
                                      <td style="text-align:right;border:none;">DATE:</td>
                                      <td style="border-bottom:1px solid;"/>
                                  </tr>
                              </table>
                          </td>
                      </tr>
                  </table>
              </div>
      </xpath>
  </template>

</odoo>
