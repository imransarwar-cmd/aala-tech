<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Report Template for Partner Ledger.-->
    <template id="partner_ledger">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="data_report_margin_top" t-value="12"/>
                <t t-set="data_report_header_spacing" t-value="9"/>
                <t t-set="data_report_dpi" t-value="110"/>
                <div class="page">
                    <h3>
                        <center>
                            <b>
                                <span t-esc="report_name"/>
                            </b>
                        </center>
                    </h3>
                    <br/>
                    <br/>
                    <table class="filters" style="font-size:12px;width:100%;">
                        <tr>
                            <td style="width:14%;vertical-align:top;">
                                <strong>Journals:</strong>
                                <ul style="margin:0;padding-left:16px;">
                                    <li><t t-out="filters.get('journals_display') or 'All'"/></li>
                                </ul>
                            </td>
                            <td style="width:14%;vertical-align:top;">
                                <strong>Accounts:</strong>
                                <ul style="margin:0;padding-left:16px;">
                                    <li><t t-out="filters.get('account_display') or 'All Payable and Receivable'"/></li>
                                </ul>
                            </td>
                            <td style="width:20%;vertical-align:top;">
                                <strong>Partners:</strong>
                                <ul style="margin:0;padding-left:16px;">
                                    <li><t t-out="filters.get('partner_display') or 'All'"/></li>
                                </ul>
                            </td>
                            <td style="width:14%;vertical-align:top;">
                                <strong>Partner Tags:</strong>
                                <ul style="margin:0;padding-left:16px;">
                                    <li><t t-out="filters.get('partner_tags_display') or 'All'"/></li>
                                </ul>
                            </td>
                            <td style="width:19%;vertical-align:top;">
                                <strong>Account Type:</strong>
                                <ul style="margin:0;padding-left:16px;">
                                    <li>Receivable and Payable</li>
                                </ul>
                            </td>
                            <td style="width:19%;vertical-align:top;">
                                <strong>Target move:</strong>
                                <ul style="margin:0;padding-left:16px;">
                                    <li><t t-out="filters.get('target_move') or 'All Posted Entries'"/></li>
                                </ul>
                            </td>
                        </tr>
                        <tr t-if="filters['start_date'] or filters['end_date']">
                            <td colspan="6">
                                <strong>Date Range:</strong>
                                <t t-if="filters['start_date']" t-out="filters['start_date']"/>
                                <t t-if="filters['end_date']">
                                    to
                                    <t t-out="filters['end_date']"/>
                                </t>
                            </td>
                        </tr>
                    </table>
                    <br/>
                    <br/>
                    <br/>
                    <t t-if="partners">
                        <t t-foreach="partners"
                           t-as="partner"
                           t-key="partner_index">
                            <table class="table table-sm table-reports" style="border:1px solid #dee2e6;table-layout:fixed;width:100%;">
                                <thead style="background:#ffffff;border-bottom:2px solid #333;">
                                    <tr>
                                        <th style="width:7%;border:1px solid #dee2e6;">Date</th>
                                        <th style="width:8%;border:1px solid #dee2e6;">Journal</th>
                                        <th style="width:8%;border:1px solid #dee2e6;">Account</th>
                                        <th style="width:15%;border:1px solid #dee2e6;">Move</th>
                                        <th style="width:38%;border:1px solid #dee2e6;">Entry Label</th>
                                        <th style="width:8%;border:1px solid #dee2e6;">Debit</th>
                                        <th style="width:8%;border:1px solid #dee2e6;">Credit</th>
                                        <th style="width:8%;border:1px solid #dee2e6;">Balance</th>
                                    </tr>
                                </thead>
                                <tbody style="font-size:12px;font-weight:100;">
                                    <tr class="border-bottom"
                                        style="background:#ffffff;">
                                        <th colspan="8"
                                            style="border:1px solid #dee2e6;">
                                            <div class="ms-3">
                                                <span class="fw-bolder">
                                                    <t t-if="partner != 'false'">
                                                        <strong>
                                                            <b>
                                                                <t t-esc="partner"/>
                                                            </b>
                                                        </strong>
                                                    </t>
                                                    <t t-else="">
                                                        <span>Unknown
                                                            Partner
                                                        </span>
                                                    </t>
                                                </span>
                                            </div>
                                        </th>
                                    </tr>
                                    <tr class="border-bottom"
                                        style="background:#ffffff;">
                                        <th style="width:7%;border:1px solid #dee2e6;"/>
                                        <th style="width:8% border:0px solid transparent;"/>
                                        <th style="width:8% border:0px solid transparent;"/>
                                        <th style="width:15% border:0px solid transparent;"/>
                                        <th style="width:38% border:0px solid transparent;"/>
                                        <th style="width:8% border:0px solid transparent;">
                                            <strong>
                                                <span>
                                                    <t t-if="total[partner]['total_debit']"
                                                       t-esc="total[partner]['total_debit_display']"/>
                                                    <t t-if="total[partner]['total_debit']"
                                                       t-esc="' ' + total[partner]['currency_id']"/>
                                                </span>
                                            </strong>
                                        </th>
                                        <th style="width:8% border:0px solid transparent;">
                                            <strong>
                                                <span>
                                                    <t t-if="total[partner]['total_credit']"
                                                       t-esc="total[partner]['total_credit_display']"/>
                                                    <t t-if="total[partner]['total_credit']"
                                                       t-esc="' ' + total[partner]['currency_id']"/>
                                                </span>
                                            </strong>
                                        </th>
                                        <th style="width:8% border:0px solid transparent;border-right: thin solid #dee2e6;">
                                            <strong>
                                                <span class="fw-bolder">
                                                    <t t-esc="'{:,.2f}'.format((total[partner]['total_debit'] or 0.0) - (total[partner]['total_credit'] or 0.0))"/>
                                                    <t t-esc="' ' + total[partner]['currency_id']"/>
                                                </span>
                                            </strong>
                                        </th>
                                    </tr>
                                    <!-- Iterate over partner's initial balance -->
                                    <t t-set="j" t-value="0"/>
                                    <t t-foreach="partners"
                                       t-as="partner_initial"
                                       t-key="partner_initial_index">
                                        <t t-set="j" t-value="j + 1"/>
                                        <t t-if="j == 1 and total[partner]['initial_balance'] != 0">
                                            <th style="width:7%;">
                                                <span style="gap: 12px;display: flex;">

                                                </span>
                                            </th>
                                            <th style="border:1px solid #dee2e6;">
                                            </th>
                                            <th style="border:1px solid #dee2e6;">
                                            </th>
                                            <th style="border:1px solid #dee2e6;">
                                                <span>
                                                    <t t-esc="total[partner]['move_name']"/>
                                                </span>
                                            </th>
                                            <th style="border:1px solid #dee2e6;">
                                            </th>
                                            <th style="border:1px solid #dee2e6;">
                                                <span>
                                                    <t t-esc="total[partner]['initial_debit_display']"/>
                                                    <t t-esc="' ' + total[partner]['currency_id']"/>
                                                </span>
                                            </th>
                                            <th style="border:1px solid #dee2e6;">
                                                <span>
                                                    <t t-esc="total[partner]['initial_credit_display']"/>
                                                    <t t-esc="' ' + total[partner]['currency_id']"/>
                                                </span>
                                            </th>
                                            <th style="border:1px solid #dee2e6;">
                                                <span>
                                                    <t t-esc="total[partner]['initial_balance_display']"/>
                                                    <t t-esc="' ' + total[partner]['currency_id']"/>
                                                </span>
                                            </th>
                                        </t>
                                    </t>
                                    <!-- Iterate over partner's value list -->
                                    <t t-foreach="data[partner]"
                                       t-as="valuelist"
                                       t-key="valuelist_index">
                                        <tr class="border-bottom">
                                            <th style="width:7%;border:1px solid #dee2e6;">
                                                <span>
                                                    <t t-esc="valuelist[0]['date']"/>
                                                </span>
                                            </th>
                                            <th style="width:8%;border:1px solid #dee2e6;">
                                                <span>
                                                    <t t-esc="valuelist[0]['jrnl']"/>
                                                </span>
                                            </th>
                                            <th style="width:8%;border:1px solid #dee2e6;">
                                                <span>
                                                    <t t-esc="valuelist[0]['code']"/>
                                                </span>
                                            </th>
                                            <th style="width:15%;border:1px solid #dee2e6;">
                                                <span>
                                                    <t t-if="valuelist[0]['move_name']"
                                                       t-esc="valuelist[0]['move_name']"/>
                                                </span>
                                            </th>
                                            <th style="width:38%;border:1px solid #dee2e6;">
                                                <span style="max-height:2.6em;overflow:hidden;display:block;line-height:1.3em;">
                                                    <t t-if="valuelist[0]['name']"
                                                       t-esc="valuelist[0]['name']"/>
                                                </span>
                                            </th>
                                            <th style="width:8%;border:1px solid #dee2e6;">
                                                <span>
                                                    <t t-if="valuelist[0]['debit']"
                                                       t-esc="valuelist[0]['debit_display']"/>
                                                    <t t-if="valuelist[0]['debit']"
                                                       t-esc="' ' + total[partner]['currency_id']"/>
                                                </span>
                                            </th>
                                            <th style="width:8%;border:1px solid #dee2e6;">
                                                <span>
                                                    <t t-if="valuelist[0]['credit']"
                                                       t-esc="valuelist[0]['credit_display']"/>
                                                    <t t-if="valuelist[0]['credit']"
                                                       t-esc="' ' + total[partner]['currency_id']"/>
                                                </span>
                                            </th>
                                            <th style="width:8%;border:1px solid #dee2e6;">
                                                <span>
                                                    <t t-esc="valuelist[0]['running_balance_display']"/>
                                                    <t t-esc="' ' + total[partner]['currency_id']"/>
                                                </span>
                                            </th>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </t>
                    <table class="table table-sm table-reports">
                        <tbody>
                            <tr>
                                <th style="width:60%;">Total</th>
                                <th style="width:8%">
                                    <t t-out="'{:,.2f}'.format((grand_total and grand_total.get('total_debit')) or 0.0)"/>
                                    <t t-out="' ' + ((grand_total and grand_total.get('currency')) or '')"/>
                                </th>
                                <th style="width:8%">
                                    <t t-out="'{:,.2f}'.format((grand_total and grand_total.get('total_credit')) or 0.0)"/>
                                    <t t-out="' ' + ((grand_total and grand_total.get('currency')) or '')"/>
                                </th>
                                <th style="width:8%">
                                    <t t-if="grand_total and grand_total.get('total_debit') and grand_total.get('total_credit')">
                                        <t t-out="'{:,.2f}'.format(((grand_total and grand_total.get('total_debit')) or 0.0) - ((grand_total and grand_total.get('total_credit')) or 0.0))"/>
                                        <t t-out="' ' + ((grand_total and grand_total.get('currency')) or '')"/>
                                    </t>
                                </th>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
