<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reservation_operation_list" model="ir.ui.view">
        <field name="name">stock.move.dvz.reservation.list</field>
        <field name="model">stock.move</field><field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Material Reservation Lines" create="0" edit="0" delete="0" decoration-warning="dvz_shortage_qty &gt; 0" decoration-muted="state in ['done', 'cancel']">
                <header>
                    <button name="action_dvz_release" type="object" string="Release Selected" groups="dvz_material_reservation.group_reservation_operator"/>
                    <button name="action_dvz_set_target" type="object" string="Set Targets" groups="dvz_material_reservation.group_reservation_operator"/>
                </header>
                <field name="dvz_reservation_id"/>
                <field name="dvz_sale_order_id"/>
                <field name="dvz_customer_id"/>
                <field name="dvz_project_id" optional="show"/>
                <field name="dvz_analytic_account_id" optional="hide"/>
                <field name="product_id"/>
                <field name="picking_id"/>
                <field name="location_id" optional="show"/>
                <field name="location_dest_id" optional="hide"/>
                <field name="product_uom_qty" string="Operation Demand"/>
                <field name="dvz_reserved_qty"/>
                <field name="dvz_target_qty" optional="show"/>
                <field name="dvz_shortage_qty"/>
                <field name="dvz_held_back_qty"/>
                <field name="product_uom"/>
                <field name="picked" optional="hide"/>
                <field name="date" optional="hide"/>
                <field name="dvz_reservation_source" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
                <button name="action_dvz_release" type="object" string="Release" icon="fa-unlock" invisible="state in ['draft', 'done', 'cancel'] or picked" groups="dvz_material_reservation.group_reservation_operator"/>
                <button name="action_dvz_set_target" type="object" string="Target" icon="fa-sliders" invisible="state in ['draft', 'done', 'cancel'] or picked" groups="dvz_material_reservation.group_reservation_operator"/>
            </list>
        </field>
    </record>
    <record id="view_reservation_operation_form" model="ir.ui.view">
        <field name="name">stock.move.dvz.reservation.form</field><field name="model">stock.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Reservation Operation" create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <button name="action_dvz_release" string="Release Quantity" type="object" invisible="state in ['draft', 'done', 'cancel'] or picked" groups="dvz_material_reservation.group_reservation_operator"/>
                    <button name="action_dvz_set_target" string="Set Reservation Target" type="object" invisible="state in ['draft', 'done', 'cancel'] or picked" groups="dvz_material_reservation.group_reservation_operator"/>
                    <button name="action_dvz_reservation_details" string="Reserved Lots / Locations" type="object" groups="stock.group_stock_user"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="picked" invisible="1"/>
                    <group>
                        <group>
                            <field name="dvz_reservation_id"/><field name="dvz_sale_order_id"/>
                            <field name="dvz_customer_id"/><field name="dvz_project_id"/><field name="dvz_analytic_account_id"/>
                            <field name="picking_id"/><field name="product_id"/>
                        </group>
                        <group>
                            <field name="product_uom_qty"/><field name="dvz_reserved_qty"/>
                            <field name="dvz_target_qty"/><field name="dvz_shortage_qty"/><field name="dvz_held_back_qty"/>
                            <field name="product_uom"/><field name="location_id"/><field name="location_dest_id"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">Completed moves show zero current reservation. Open the linked transfer for quantities actually delivered. Reservation changes never validate a transfer or edit the SO quantity.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_reservation_operation_search" model="ir.ui.view">
        <field name="name">stock.move.dvz.reservation.search</field><field name="model">stock.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search>
                <field name="dvz_reservation_id"/><field name="dvz_sale_order_id"/><field name="dvz_customer_id"/>
                <field name="dvz_project_id"/><field name="dvz_analytic_account_id"/><field name="product_id"/>
                <field name="picking_id"/><field name="location_id"/>
                <filter name="open" string="Open Operations" domain="[('state', 'not in', ['done', 'cancel'])]"/>
                <filter name="reserved" string="With Reserved Stock" domain="[('dvz_reserved_qty', '&gt;', 0)]"/>
                <filter name="shortages" string="Waiting for Stock" domain="[('dvz_shortage_qty', '&gt;', 0)]"/>
                <filter name="released" string="Released / Limited" domain="[('dvz_reservation_limit_enabled', '=', True)]"/>
                <separator/>
                <filter name="manual" string="Manual Customer Holds" domain="[('dvz_reservation_source', '=', 'manual')]"/>
                <filter name="customer_only" string="Without Project" domain="[('dvz_project_id', '=', False), ('dvz_analytic_account_id', '=', False)]"/>
                <group>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'dvz_customer_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'dvz_project_id'}"/>
                    <filter name="group_analytic" string="Analytic Project" context="{'group_by': 'dvz_analytic_account_id'}"/>
                    <filter name="group_sale" string="Sales Order" context="{'group_by': 'dvz_sale_order_id'}"/>
                    <filter name="group_reservation" string="Reservation" context="{'group_by': 'dvz_reservation_id'}"/>
                    <filter name="group_product" string="Product and Unit" context="{'group_by': ['product_id', 'product_uom']}"/>
                    <filter name="group_transfer" string="Transfer / Stage" context="{'group_by': 'picking_id'}"/>
                    <filter name="group_source" string="Source Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_state" string="Operation Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_reservation_operations" model="ir.actions.act_window">
        <field name="name">Material Reservation Lines</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_reservation_operation_search"/>
        <field name="domain">[('dvz_reservation_id', '!=', False)]</field>
        <field name="context">{'create': False, 'search_default_open': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_reservation_operation_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_reservation_operation_form')})]"/>
    </record>
</odoo>
