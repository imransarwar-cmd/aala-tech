<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_material_reservations" model="ir.ui.view">
        <field name="name">sale.order.form.dvz.material.reservations</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dvz_material_reservations" type="object" class="oe_stat_button" icon="fa-cubes" invisible="state not in ['sale', 'cancel']" groups="stock.group_stock_user,sales_team.group_sale_salesman">
                    <field name="dvz_material_reservation_count" widget="statinfo" string="Material Reservations"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_dvz_sync_material_reservations" type="object" string="Refresh Material Reservations" invisible="state != 'sale'" groups="dvz_material_reservation.group_reservation_operator"/>
            </xpath>
        </field>
    </record>
</odoo>
