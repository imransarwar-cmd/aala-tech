<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reservation_adjust_form" model="ir.ui.view">
        <field name="name">dvz.reservation.adjust.form</field>
        <field name="model">dvz.reservation.adjust</field>
        <field name="arch" type="xml">
            <form string="Release / Adjust Material Reservation">
                <div class="alert alert-info" role="alert" invisible="mode != 'release'">
                    Enter the quantity to RELEASE for each product. Zero skips a line. Release all also stops future automatic reservation for every displayed operation. Demand and Sales Order quantities do not change.
                </div>
                <div class="alert alert-info" role="alert" invisible="mode != 'target'">
                    Enter the NEW TOTAL target to keep reserved, not an additional quantity. Odoo reserves only available stock up to this target. This does not validate a delivery.
                </div>
                <group>
                    <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                    <field name="mode" readonly="1"/>
                    <field name="release_all" invisible="mode != 'release'"/>
                    <field name="reason" placeholder="e.g. Customer postponed installation / release 3 controllers"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="move_id" column_invisible="True"/>
                        <field name="reservation_id" readonly="1" optional="hide"/>
                        <field name="picking_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="demand_qty" readonly="1"/>
                        <field name="reserved_qty" readonly="1"/>
                        <field name="target_qty" readonly="1" optional="show"/>
                        <field name="quantity" readonly="parent.mode == 'release' and parent.release_all"/>
                        <field name="uom_id" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" string="Apply Reservation Change" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
