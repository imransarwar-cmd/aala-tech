<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reservation_settings_form" model="ir.ui.view">
        <field name="name">dvz.reservation.settings.form</field>
        <field name="model">dvz.reservation.settings</field>
        <field name="arch" type="xml">
            <form string="Material Reservation Settings">
                <group>
                    <field name="company_id" readonly="1"/>
                    <field name="automatic"/>
                    <field name="project_field_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="project_reference_field_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <div class="alert alert-info" role="alert">
                    The project mapping reuses an existing SO Project or Analytic Account field. The text-reference mapping copies an existing SO Char field into the reservation for reference only. No duplicate project field is added to the SO. If empty, only unambiguous native links or the existing dvz_origin_sale_id link are used. No project is matched by name. This setting affects future confirmations/refreshes, not existing stock retroactively.
                </div>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_reservation_settings" model="ir.actions.act_window">
        <field name="name">Material Reservation Settings</field>
        <field name="res_model">dvz.reservation.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
