<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view only (not Kanban, per instruction) - new tab holding
         Project/Status header fields and the System/Activity/Product
         line table, added as a whole new <page> for robustness against
         the exact existing form structure. -->
    <record id="dvz_crm_lead_form_project_lines" model="ir.ui.view">
        <field name="name">crm.lead.form.dvz.project.lines</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Native "Contact" label -> "Customer" - crm.lead's form
                 has TWO separate partner_id fields (Leads vs.
                 Opportunities groups, mutually exclusive by type); this
                 targets specifically the one inside opportunity_partner,
                 confirmed as the one actually visible on Opportunities. -->
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="attributes">
                <attribute name="string">Customer</attribute>
            </xpath>

            <!-- Native "Properties" widget ("Property 1" placeholder) -
                 hidden entirely, since it can't be renamed from here
                 (it's Odoo's own dynamic Properties feature, configured
                 per-team, not a field this module defines). -->
            <xpath expr="//field[@name='lead_properties']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Native "Tags" field hidden per request. -->
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='lost_reason_id']" position="before">
                <field name="system_id"/>
                    <field name="sales_id"/>
                    <field name="presales_id"/>
                <field name="activity"/>
            </xpath>

            <!-- Inquiry and Due Date appear BEFORE Expected Closing
                 (date_deadline). Est. Closing is no longer added at all
                 (removed per request) - only its per-line equivalent in
                 the table below remains, which is unaffected. -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="inquiry_date"/>
                <field name="due_date"/>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Lines" name="dvz_project_lines">
                    <group>
                        <group><field name="dvz_project"/></group>
                        <group>
                            <field name="dvz_status"/>
                        </group>


                    </group>
                    <field name="dvz_line_ids">
                        <list editable="bottom">
                            <field name="product_id" optional="show"/>
                            <field name="name" string="Description" optional="show"/>
                            <field name="quantity" optional="show"/>
                            <field name="price_unit" optional="show"/>
                            <field name="tax_ids" widget="many2many_tags" optional="show"/>
                            <field name="margin_percent" optional="show"/>
                            <field name="margin_amount" optional="show"/>
                            <field name="amount" optional="show"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer" colspan="2">
                        <field name="dvz_amount_untaxed" widget="float" string="Untaxed Amount"/>
                        <field name="dvz_amount_tax" widget="float" string="Taxes"/>
                        <field name="dvz_amount_total" widget="float" string="Total"
                               class="oe_subtotal_footer_separator"/>
                        <field name="dvz_margin_total" widget="float" string="Total Margin"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Kanban quick-create card (the small inline "Add" form shown when
         creating a lead directly from a Kanban column). Customer
         (partner_id) is already the first field on this card by default
         - this inserts Project, System, and a Date field (date_deadline,
         a real native field already on crm.lead) immediately after it. -->
    <record id="dvz_crm_lead_quick_create_form" model="ir.ui.view">
        <field name="name">crm.lead.form.dvz.quick.create</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="after">
                <field name="dvz_project"/>
                <field name="dvz_system_id"/>
                <field name="date_deadline" string="Date"/>
            </xpath>
        </field>
    </record>

</odoo>
