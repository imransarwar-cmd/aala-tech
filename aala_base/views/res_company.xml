<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="res_company_form_inherit" model="ir.ui.view">
        <field name="name">res_company_form_inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="oe_title">
                        <label for="arabic_name" class="oe_edit_only"/>
                        <h1>
                            <field name="arabic_name" placeholder="Arabic Name"/>
                        </h1>
                    </div>
            </xpath>
            <xpath expr="//field[@name='phone']" position="before">
                <field name="arabic_address" placeholder="Street 1"/>
                <field name="arabic_address_s2" placeholder="Street 2"/>
                <field name="arabic_address_city" placeholder="City"/>
                <field name="arabic_zip" placeholder="Zip"/>
            </xpath>
            <xpath expr="//field[@name='phone']" position="after">
                <field name="cr_no"/>
            </xpath>
        </field>
    </record>
    <record id="res_country_form_inherit" model="ir.ui.view">
        <field name="name">res_country_form_inherit</field>
        <field name="model">res.country</field>
        <field name="inherit_id" ref="base.view_country_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="arabic_name"/>
            </xpath>
        </field>
    </record>
</odoo>