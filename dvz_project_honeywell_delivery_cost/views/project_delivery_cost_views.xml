<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dvz_project_delivery_cost_line_list" model="ir.ui.view">
        <field name="name">dvz.project.delivery.cost.line.list</field>
        <field name="model">dvz.project.delivery.cost.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="delivery_date"/>
                <field name="picking_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="delivered_qty"/>
                <field name="product_uom_id"/>
                <field name="analytic_percent"/>
                <field name="unit_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Delivered Cost"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dvz_project_delivery_cost_line_form" model="ir.ui.view">
        <field name="name">dvz.project.delivery.cost.line.form</field>
        <field name="model">dvz.project.delivery.cost.line</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="analytic_account_id"/>
                            <field name="sale_order_id"/>
                            <field name="sale_line_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="picking_id"/>
                            <field name="stock_move_id"/>
                            <field name="delivery_date"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Cost">
                        <field name="delivered_qty"/>
                        <field name="product_uom_id"/>
                        <field name="analytic_percent"/>
                        <field name="unit_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
