<odoo>
    <record id="view_delivery_attachment_list" model="ir.ui.view">
        <field name="name">delivery.attachment.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list string="Delivery Documents" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="mimetype" optional="show"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_attachment_form" model="ir.ui.view">
        <field name="name">delivery.attachment.form</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <form string="Delivery Attachment" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="mimetype" readonly="1"/>
                        <field name="datas"
                               filename="name"
                               widget="binary"
                               readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>


