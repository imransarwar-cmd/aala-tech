<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_delivery_attachment_list"
            model="ir.ui.view">
        <field name="name">stock.picking.delivery.attachment.list</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>

        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">

                <field name="picking_type_code"
                       column_invisible="True"/>

                <button name="action_view_delivery_attachments"
                        type="object"
                        icon="fa-paperclip"
                        title="View Attachments"
                        invisible="picking_type_code != 'outgoing' or delivery_attachment_count == 0"/>

                <field name="delivery_attachment_count"
                       string=" "
                       readonly="1"
                       invisible="picking_type_code != 'outgoing' or delivery_attachment_count == 0"/>

            </xpath>
        </field>
    </record>
</odoo>
