<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_dvz_leave_policy" model="ir.ui.view">
        <field name="name">hr.employee.form.dvz.policy</field><field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Leave Policy" name="dvz_leave_policy" groups="hr_holidays.group_hr_holidays_manager,hr.group_hr_manager">
                    <button name="action_dvz_open_policy_setup" type="object" string="Set Up This Employee" class="btn-primary" invisible="not id" groups="hr_holidays.group_hr_holidays_manager"/>
                    <p class="text-muted">When saved, a new employee receives the company's configured policy. Joining date, employment status and paid eligibility can be confirmed later. Paid leave and allocation remain unavailable until the required eligibility details are verified.</p>
                    <group>
                        <group string="Policy Assignment">
                            <field name="dvz_leave_policy_id" options="{'no_create': True}"/>
                            <field name="leave_manager_id" string="HOD / Time Off Approver" options="{'no_create': True}"/>
                            <field name="dvz_employment_status"/>
                        </group>
                        <group string="Verified Eligibility">
                            <field name="dvz_joining_date"/>
                            <field name="dvz_probation_end_date"/>
                            <field name="dvz_paid_eligible_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
