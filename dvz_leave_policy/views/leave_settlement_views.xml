<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dvz_leave_settlement_list" model="ir.ui.view">
        <field name="name">dvz.leave.settlement.list</field><field name="model">dvz.leave.settlement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'">
                <field name="name"/><field name="employee_id"/><field name="policy_id"/>
                <field name="company_id" groups="base.group_multi_company"/><field name="period_start"/><field name="period_end"/>
                <field name="unused_days"/><field name="currency_id" column_invisible="True"/><field name="amount" sum="Total"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_dvz_leave_settlement_search" model="ir.ui.view">
        <field name="name">dvz.leave.settlement.search</field><field name="model">dvz.leave.settlement</field>
        <field name="arch" type="xml">
            <search string="Year-End Encashments">
                <field name="employee_id"/><field name="policy_id"/><field name="name"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="group_policy" string="Policy" context="{'group_by':'policy_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_dvz_leave_settlement_form" model="ir.ui.view">
        <field name="name">dvz.leave.settlement.form</field><field name="model">dvz.leave.settlement</field>
        <field name="arch" type="xml">
            <form string="Year-End Leave Encashment">
                <header>
                    <button name="action_calculate" string="Calculate Balance" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve Encashment" type="object" invisible="state != 'draft'"/>
                    <button name="action_paid" string="Record Payment" type="object" class="btn-primary" invisible="state != 'approved' or amount &lt;= 0"/>
                    <button name="action_cancel" string="Cancel Draft" type="object" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Reopen Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,paid"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name" readonly="state != 'draft'"/></h1></div>
                    <group>
                        <group><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/><field name="policy_id" readonly="state != 'draft'" options="{'no_create': True}"/><field name="employee_id" readonly="state != 'draft'" options="{'no_create': True}"/></group>
                        <group><field name="period_start" readonly="state != 'draft'"/><field name="period_end" readonly="state != 'draft'"/><field name="unused_days" readonly="1"/></group>
                    </group>
                    <group string="Approved Rate">
                        <field name="daily_rate" readonly="state != 'draft'"/><field name="rate_reference" readonly="state != 'draft'"/><field name="amount" readonly="1"/>
                    </group>
                    <p class="text-muted">All reconciled unused days are encashed at the entered approved daily rate. The source does not supply a rate. No payroll entry or bank payment is created.</p>
                    <group string="Actual Payment Record"><field name="payment_reference" readonly="state != 'approved'"/><field name="paid_date" readonly="state != 'approved'"/></group>
                    <group string="Calculation and Approval">
                        <group><field name="calculated_at" readonly="1"/><field name="calculated_by_id" readonly="1"/></group>
                        <group><field name="approved_at" readonly="1"/><field name="approved_by_id" readonly="1"/></group>
                    </group>
                    <field name="source_allocation_ids" widget="many2many_tags" readonly="1"/>
                    <field name="notes" readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_dvz_leave_settlement" model="ir.actions.act_window">
        <field name="name">Year-End Encashments</field><field name="res_model">dvz.leave.settlement</field>
        <field name="view_mode">list,form</field><field name="search_view_id" ref="view_dvz_leave_settlement_search"/>
    </record>
</odoo>
