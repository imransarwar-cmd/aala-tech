<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dvz_leave_allocation_wizard_form" model="ir.ui.view">
        <field name="name">dvz.leave.allocation.wizard.form</field><field name="model">dvz.leave.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Leave Allocation">
                <group>
                    <group>
                        <field name="policy_id" domain="[('state','=','active')]" options="{'no_create': True}"/>
                        <field name="employee_id" options="{'no_create': True}"/>
                    </group>
                    <group><field name="as_of_date"/><field name="approve"/></group>
                </group>
                <field name="line_ids" readonly="1" nolabel="1">
                    <list create="0" delete="0">
                        <field name="employee_id"/><field name="period_start"/><field name="period_end"/>
                        <field name="days"/><field name="status"/><field name="message"/>
                    </list>
                </field>
                <footer>
                    <button name="action_preview" type="object" string="Preview" class="btn-primary"/>
                    <button name="action_generate" type="object" string="Generate Employee Allocation"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_dvz_leave_allocation_wizard" model="ir.actions.act_window">
        <field name="name">Employee Leave Allocation</field><field name="res_model">dvz.leave.allocation.wizard</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>
</odoo>
