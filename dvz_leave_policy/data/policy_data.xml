<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="policy_standard_draft" model="dvz.leave.policy">
            <field name="name">Standard Leave Policy</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="state">draft</field>
            <field name="is_default" eval="False"/>
            <field name="annual_days">24</field>
            <field name="request_unit">half_day</field>
            <field name="approval_mode">both</field>
            <field name="approval_order">hod_hr</field>
            <field name="distinct_approvers" eval="True"/>
            <field name="half_day_notice_days">1</field>
            <field name="year_end_action">encash</field>
            <field name="auto_allocation" eval="False"/>
            <field name="automatic_return_check" eval="False"/>
            <field name="notes">Review the effective dates, eligibility, proration, leave types, approvers and year-end rates before activating this policy. All values are editable in draft. Installation does not assign employees or create leave allocations.</field>
        </record>
    </data>
</odoo>
