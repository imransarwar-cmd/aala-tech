<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_dvz_leave_policy_company" model="ir.rule">
            <field name="name">Leave policies: allowed companies</field>
            <field name="model_id" ref="model_dvz_leave_policy"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_dvz_leave_settlement_company" model="ir.rule">
            <field name="name">Leave settlements: allowed companies</field>
            <field name="model_id" ref="model_dvz_leave_settlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_dvz_leave_allocation_wizard_company" model="ir.rule">
            <field name="name">Policy allocation wizard: allowed companies</field>
            <field name="model_id" ref="model_dvz_leave_allocation_wizard"/>
            <field name="domain_force">[('policy_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_dvz_leave_allocation_wizard_line_company" model="ir.rule">
            <field name="name">Policy allocation preview: allowed companies</field>
            <field name="model_id" ref="model_dvz_leave_allocation_wizard_line"/>
            <field name="domain_force">[('wizard_id.policy_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_dvz_policy_setup_wizard_company" model="ir.rule">
            <field name="name">Policy setup: allowed companies</field>
            <field name="model_id" ref="model_dvz_policy_setup_wizard"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
