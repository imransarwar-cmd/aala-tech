<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_crm_lead_quotation" model="ir.actions.report">
        <field name="name">Quotation (Excel style)</field>
        <field name="model">crm.lead</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dvz_crm_ext.report_crm_lead_quotation_document</field>
        <field name="report_file">dvz_crm_ext.report_crm_lead_quotation_document</field>
        <field name="print_report_name">'Quotation - %s' % (object.quotation_no or object.name)</field>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_type">report</field>
        <!-- Saves the generated PDF as an ir.attachment on the
             Opportunity itself (visible in the chatter's attachment
             list), instead of only being a one-off download. Re-printing
             after the underlying data changes creates a fresh dated copy
             rather than silently overwriting the old one. -->
        <field name="attachment_use">True</field>
        <field name="attachment">'Quotation - %s - %s.pdf' % (object.quotation_no or object.name, time.strftime('%Y-%m-%d'))</field>
    </record>

    <template id="report_crm_lead_quotation_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                <div class="page dvz_quotation article"
                     t-att-data-oe-model="'crm.lead'" t-att-data-oe-id="o.id">
                    <style>
                        .dvz_quotation { font-family: Calibri, Arial, sans-serif; font-size: 15px; color: #000000; }
                        .dvz_quotation h1 { font-size: 26px; margin-bottom: 0; }
                        .dvz_quotation h2 { font-size: 19px; margin-top: 4px; }
                        .dvz_quotation .dvz_sub { font-size: 16px; margin: 4px 0; }
                        .dvz_quotation table.dvz_items { width: 100%; border-collapse: collapse; margin-top: 10px; }
                        .dvz_quotation table.dvz_items th,
                        .dvz_quotation table.dvz_items td { border: 1px solid #999999; padding: 6px 8px; font-size: 15px; vertical-align: middle; }
                        .dvz_quotation table.dvz_items th { background-color: #ddebf7; text-align: center; font-weight: bold; }
                        .dvz_quotation td.num { text-align: right; }
                        .dvz_quotation td.ctr { text-align: center; }
                        .dvz_quotation table.dvz_totals td { border: none; padding: 4px 8px; font-size: 15px; font-weight: bold; }
                        .dvz_quotation table.dvz_totals tr.dvz_total_row td { background-color: #ddebf7; }
                        .dvz_quotation table.dvz_totals tr.dvz_grand_total td { background-color: #ddebf7; font-size: 17px; }
                        .dvz_quotation .dvz_box { border: 1px solid #999999; padding: 10px; min-height: 90px; font-size: 15px; }
                        .dvz_quotation .dvz_terms td { padding: 4px 8px; vertical-align: top; font-size: 15px; }
                        .dvz_quotation .dvz_intro { font-size: 18px; }
                        .dvz_quotation .dvz_signature_name {
                            font-family: 'Brush Script MT', 'Segoe Script', cursive;
                            font-size: 22px; border-bottom: 1px solid #000000;
                            padding-bottom: 2px; margin-bottom: 6px; display: inline-block;
                        }
                    </style>

                    <!-- ============ Cover block (matches Sheet '1') ============
                         No separate logo image here - web.external_layout's
                         own header already shows the company logo (set on
                         Settings > Companies), so adding a second one here
                         would just duplicate it. -->

                    <!-- Banner - the actual "COMMERCIAL OFFER" graphic
                         from the company's Excel template. -->
                    <img t-att-src="'/dvz_crm_ext/static/src/img/commercial_offer_banner.jpg'"
                         style="width:100%; max-height:260px; object-fit:cover; margin-bottom: 14px;"/>

                    <table style="width:100%; margin-bottom: 10px;">
                        <tr>
                            <td style="width:55%; vertical-align: middle; background-color:#dde8f5; padding: 14px;">
                                <div class="text-center">
                                    <strong><span t-esc="o.quotation_title or o.name or 'Project Title'"/></strong><br/>
                                    for<br/>
                                    <strong><span t-esc="o.quotation_site or o.partner_id.name or 'Client / Site Name'"/></strong>
                                </div>
                            </td>
                            <td style="width:45%; text-align:center; vertical-align: middle;">
                                <img t-if="o.quotation_client_logo"
                                     t-att-src="image_data_uri(o.quotation_client_logo)"
                                     style="max-height:60px; max-width:240px;"/>
                                <div t-else="" style="border: 1px dashed #999999; color:#999999;
                                            display:inline-block; padding: 16px 30px; font-size:13px;">
                                    CLIENT / PRODUCT LOGO
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table style="width:100%; margin-bottom: 15px;">
                        <tr>
                            <td style="width:50%;">
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%b-%Y')"/>
                            </td>
                            <td style="width:50%; text-align:right;">
                                <strong t-esc="o.quotation_no or '-'"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Flows naturally right after the date/quote-no row
                         (the earlier "pin to bottom of page" version used
                         a min-height trick that was overflowing onto
                         extra physical pages, so that's been dropped). -->
                    <table style="width:100%; margin-top: 20px;">
                        <tr>
                            <td style="width:50%; vertical-align: top; padding-right: 8px;">
                                <div class="dvz_box">
                                    <strong>Submitted to:</strong><br/>
                                    <span t-field="o.customer_contact_id.name"/><br/>
                                    <span t-field="o.customer_contact_id.function"/><br/>
                                    <span t-field="o.partner_id.name"/><br/>
                                    Mobile: <span t-field="o.contact_phone"/><br/>
                                    Email: <span t-field="o.contact_email_from"/>
                                </div>
                            </td>
                            <td style="width:50%; vertical-align: top; padding-left: 8px;">
                                <div class="dvz_box">
                                    <strong>Prepared by:</strong><br/>
                                    <span t-field="o.user_id.name"/><br/>
                                    <span t-field="o.user_id.partner_id.function"/><br/>
                                    <span t-field="o.company_id.name"/><br/>
                                    Mobile: <span t-esc="o.user_id.partner_id.phone or ''"/><br/>
                                    Email: <span t-field="o.user_id.email"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div style="page-break-before: always;"/>

                    <!-- ============ Quotation body (matches Sheet '2') ============ -->
                    <div class="dvz_intro">
                        <p><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%b-%Y')"/></p>
                        <p>Dear <span t-field="o.customer_contact_id.name"/>,</p>
                        <p t-field="o.quotation_intro"/>
                    </div>

                    <table class="dvz_items">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Code</th>
                                <th>Description</th>
                                <th>Qty</th>
                                <th>Unit Price<br/>In SR</th>
                                <th>Total Price<br/>In SR</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.dvz_line_ids" t-as="line">
                                <tr>
                                    <td class="ctr" t-esc="line_index + 1"/>
                                    <td><span t-field="line.code"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="ctr" t-esc="'%.2f' % line.quantity"/>
                                    <td class="num" t-esc="'%.2f' % line.price_unit"/>
                                    <td class="num" t-esc="'%.2f' % line.amount"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <table class="dvz_totals" style="width:100%; margin-top: 10px;">
                        <tr class="dvz_total_row">
                            <td style="text-align:left; width:80%;">TOTAL VALUE</td>
                            <td style="text-align:right; width:20%;" t-esc="'%.2f' % o.dvz_amount_untaxed"/>
                        </tr>
                        <tr>
                            <td style="text-align:left;">15% VAT</td>
                            <td style="text-align:right;" t-esc="'%.2f' % (o.dvz_amount_untaxed * 0.15)"/>
                        </tr>
                        <tr class="dvz_grand_total">
                            <td style="text-align:left;">
                                TOTAL VALUE IN SAUDI RIYALS (INCLUDING VAT)
                            </td>
                            <td style="text-align:right;" t-esc="'%.2f' % (o.dvz_amount_untaxed * 1.15)"/>
                        </tr>
                    </table>

                    <h4 style="margin-top:20px;">Terms &amp; Conditions:</h4>
                    <table style="width:100%;" class="dvz_terms">
                        <tr><td style="width:20%;">Validity:</td><td><span t-field="o.validity"/></td></tr>
                        <tr><td>Payment:</td><td><span t-field="o.payment_terms"/></td></tr>
                        <tr><td>Delivery:</td><td>06 - 09 Weeks</td></tr>
                        <tr><td>Bank Account:</td><td>Aala Tech Company Ltd, SAB - Saudi Awwal Bank, IBAN SA63 4500 0000 2214 7957 9001</td></tr>
                    </table>

                    <p style="margin-top: 20px;" t-field="o.quotation_outro"/>
                    <p>Thank you and best regards.</p>

                    <table style="width:100%; margin-top:40px;">
                        <tr>
                            <td style="width:50%; vertical-align: top;">
                                <div class="dvz_signature_name">Fasih U Din Yazdani</div><br/>
                                Fasih U Din Yazdani<br/>
                                Estimation Engineer<br/>
                                Aala Tech Company Ltd.<br/>
                                Mobile: +92 304 499 5659
                            </td>
                            <td style="width:50%; vertical-align: top;">
                                <div class="dvz_signature_name">Amr Elkeshk</div><br/>
                                Amr Elkeshk<br/>
                                Head of BMS &amp; Automation Division<br/>
                                Aala Tech Company Ltd.<br/>
                                Mobile: +966 50 067 9697
                            </td>
                        </tr>
                    </table>
                </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
