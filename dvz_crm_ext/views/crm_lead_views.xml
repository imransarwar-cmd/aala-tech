<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view only (not Kanban, per instruction) - new tab holding
         Project/Status header fields and the System/Activity/Product
         line table, added as a whole new <page> for robustness against
         the exact existing form structure. -->
    <record id="dvz_crm_lead_form_project_lines" model="ir.ui.view">
        <field name="name">crm.lead.form.dvz.project.lines</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Native "Contact" label -> "Customer" - crm.lead's form
                 has TWO separate partner_id fields (Leads vs.
                 Opportunities groups, mutually exclusive by type); this
                 targets specifically the one inside opportunity_partner,
                 confirmed as the one actually visible on Opportunities. -->
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="attributes">
                <attribute name="string">Customer</attribute>
                <!-- Only real customers (customer_rank > 0) show up here -
                     vendors-only and employee-linked partner records are
                     filtered out. If your customers aren't tagged this
                     way yet, swap this domain for whatever marks a
                     partner as a customer in this database (e.g. a
                     partner category/tag). -->
                <attribute name="domain">[('customer_rank', '&gt;', 0)]</attribute>
            </xpath>

            <!-- Native Email/Phone hidden - superseded by Contact Email/
                 Contact Phone below (which come from the selected
                 Contact, not typed in separately), so showing both
                 pairs at once was just confusing/redundant. -->
            <xpath expr="//field[@name='email_from']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Native Salesperson field hidden where it natively sits -
                 shown instead as "Sale Person" in the left column below.
                 This runs BEFORE that insertion (not after) - once a
                 second field named user_id exists in the tree, further
                 xpaths targeting //field[@name='user_id'] would become
                 ambiguous (matching both instances). -->
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ================= RIGHT COLUMN - hidden entirely while
                 this record's pipeline STAGE is named "Lead" (not based
                 on the record's type field), shown once it moves past
                 that stage: Presale, Inquiry Date, Expected Closing,
                 Product Logo. =================
                 is_lead_stage (crm_lead.py) is loaded here invisibly so
                 the conditions below can actually reference it.
                 Presale (presales_id) was previously force-hidden
                 (invisible="1" unconditionally) - now shown, but only
                 past the Lead stage, matching the rest of this group.
                 Positioned before/after the native Salesperson field
                 (user_id) - this MUST run here, before the "Sale
                 Person" duplicate of user_id gets inserted below,
                 while user_id is still a single, unambiguous match. -->
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="is_lead_stage" invisible="1"/>
                <field name="presales_id" string="Presale" invisible="is_lead_stage"/>
                <field name="inquiry_date" invisible="is_lead_stage"/>
            </xpath>

            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="invisible">is_lead_stage</attribute>
            </xpath>

            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="quotation_client_logo" widget="image" class="oe_avatar"
                       invisible="is_lead_stage"/>
            </xpath>

            <!-- Expected Closing (native date_deadline) - same
                 past-Lead-stage visibility as the rest of this group. -->
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="invisible">is_lead_stage</attribute>
            </xpath>

            <!-- The native group wrapping Salesperson/Expected Closing/Priority/
     Tags currently hides itself based on type == 'lead' - override
     that to the same is_lead_stage condition used everywhere else in
     this form, since fixing only the field inside it (below) would be
     pointless while the enclosing group itself stays governed by the
     old condition. -->
            <xpath expr="//field[@name='date_deadline']/ancestor::group[1]" position="attributes">
                <attribute name="invisible">is_lead_stage</attribute>
            </xpath>


            <!-- Product Logo - hidden while still in the Lead stage,
                 since this early there usually isn't a quotation/brand
                 logo yet. -->


            <!-- ================= LEFT COLUMN (always visible, both
                 Lead and Opportunity types) =================
                 Everything below is inserted right after Customer, in
                 the SAME group/column Customer is already in - Contact,
                 Contact Email, Contact Phone, System, Project, Area,
                 Brand, Due Date, Sales, then a second, relabeled
                 instance of the native Salesperson field ("Sale
                 Person"), Activity (now a dropdown), and Remarks. Odoo
                 allows a field to appear more than once, bound to the
                 same underlying value, which is how it gets "moved"
                 into this column without disturbing whatever group it
                 natively lives in (hidden there, just above). This
                 inserts the SECOND user_id - everything above that also
                 targets //field[@name='user_id'] must run first. -->
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="after">
                <field name="customer_contact_id"
                       string="Contact"
                       widget="res_partner_many2one"
                       context="{'default_parent_id': partner_id, 'default_company_name': False}"/>
                <field name="contact_email_from" readonly="1" force_save="1"/>
                <field name="contact_phone" readonly="1" force_save="1"/>
                <field name="system_ids" widget="many2many_tags"/>
                <field name="dvz_project" widget="many2many_tags"/>
                <field name="area_ids" widget="many2many_tags"/>
                <field name="brand_ids" widget="many2many_tags"/>
                <field name="due_date"/>
                <field name="sales_ids" widget="many2many_tags" invisible="1"/>
                <field name="user_id" string="Sale Person"/>
                <field name="dvz_activity_ids" widget="many2many_tags"/>
                <field name="remarks"/>
            </xpath>

            <!-- Native "Properties" widget ("Property 1" placeholder) -
                 hidden entirely, since it can't be renamed from here
                 (it's Odoo's own dynamic Properties feature, configured
                 per-team, not a field this module defines). -->
            <xpath expr="//field[@name='lead_properties']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Native "Tags" field hidden per request. -->
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Status - removed from the form per request (the
                 underlying dvz_status field itself is untouched, since
                 sale_order.py's quotation-defaults copy still reads it -
                 this only hides it from view). -->
            <xpath expr="//field[@name='lost_reason_id']" position="after">
                <field name="dvz_status" invisible="1"/>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Lines" name="dvz_project_lines">
                    <field name="dvz_line_ids">
                        <list editable="bottom">
                            <field name="product_id" optional="show"/>
                            <field name="code" optional="show"/>
                            <field name="name" string="Description" optional="show"/>
                            <field name="quantity" optional="show"/>
                            <field name="price_unit" string="Unit Price In SR" optional="show"/>
                            <field name="amount" string="Total Price In SR" optional="show"/>
                            <field name="profit_percent" string="Profit %age" optional="show"/>
                            <field name="list_price" optional="show"/>
                            <field name="discount" optional="show"/>
                            <field name="freight_percent" string="Freight &amp; Custom" optional="show"/>
                            <field name="exchange_rate" optional="hide"/>
                            <field name="unit_cost" string="Unit Cost In SR" optional="show"/>
                            <field name="total_cost" string="Total Cost In SR" optional="show"/>
                            <field name="tax_ids" widget="many2many_tags" optional="hide"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer" colspan="2">
                        <field name="dvz_amount_untaxed" widget="float" string="Untaxed Amount"/>
                        <field name="dvz_amount_tax" widget="float" string="Taxes"/>
                        <field name="dvz_amount_total" widget="float" string="Total"
                               class="oe_subtotal_footer_separator"/>
                        <field name="dvz_margin_total" widget="float" string="Total Margin"/>
                    </group>
                </page>
                <page string="Quotation Info" name="dvz_quotation_info">
                    <group>
                        <group string="Quotation Header">
                            <field name="quotation_no"/>
                            <field name="quotation_title"/>
                            <field name="quotation_site"/>
                        </group>
                    </group>
                    <group>
                        <group string="Terms &amp; Conditions">
                            <field name="validity"/>
                            <field name="payment_terms"/>
                            <field name="delivery_terms"/>
                            <field name="bank_details"/>
                        </group>
                        <group string="Quotation Text">
                            <field name="quotation_intro" nolabel="1"/>
                            <field name="quotation_outro" nolabel="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- "Print Quotation" button next to the statusbar, producing
                 the Excel-style PDF (see report/crm_lead_quotation_report.xml).
                 Just downloads/opens the PDF - no auto-attach. -->
            <xpath expr="//header" position="inside">
                <button name="%(dvz_crm_ext.action_report_crm_lead_quotation)d"
                        string="Print Quotation" type="action"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>


</odoo>
