<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Brand -->
    <record id="dvz_brand_view_list" model="ir.ui.view">
        <field name="name">dvz.brand.list</field>
        <field name="model">dvz.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="dvz_brand_view_form" model="ir.ui.view">
        <field name="name">dvz.brand.form</field>
        <field name="model">dvz.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dvz_brand_action" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">dvz.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Area -->
    <record id="dvz_area_view_list" model="ir.ui.view">
        <field name="name">dvz.area.list</field>
        <field name="model">dvz.area</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="dvz_area_action" model="ir.actions.act_window">
        <field name="name">Areas</field>
        <field name="res_model">dvz.area</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Activity -->
    <record id="dvz_activity_view_list" model="ir.ui.view">
        <field name="name">dvz.activity.list</field>
        <field name="model">dvz.activity</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="dvz_activity_action" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">dvz.activity</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menu entries under CRM > Configuration -->
    <menuitem id="dvz_brand_menu" name="Brands"
              parent="crm.crm_menu_config" action="dvz_brand_action"
              sequence="50"/>
    <menuitem id="dvz_area_menu" name="Areas"
              parent="crm.crm_menu_config" action="dvz_area_action"
              sequence="51"/>
    <menuitem id="dvz_activity_menu" name="Activities"
              parent="crm.crm_menu_config" action="dvz_activity_action"
              sequence="52"/>

</odoo>
