<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dvz_sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.dvz.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- "Print Quotation" button, reusing the same Excel-style
                 report from the Opportunity (see action_print_dvz_quotation
                 in sale_order.py). -->
            <xpath expr="//header" position="inside">
                <button name="action_print_dvz_quotation"
                        string="Print Quotation" type="object"
                        class="btn-secondary"/>
            </xpath>
            <!-- Own FULL-WIDTH group between the header and the tabs,
                 rather than squeezed inside partner_id's existing
                 narrow half-column (not enough room there for a clean
                 2-column split - labels were wrapping across 3 lines). -->
            <xpath expr="//notebook" position="before">
                <group>
                    <group>
                        <field name="brand_id"/>
                        <field name="area_id"/>
                        <field name="po_ref"/>
                        <field name="priority"/>
                    </group>
                    <group>
                        <field name="estimation_engineer_id"/>
                        <field name="remarks"/>
                    </group>
                </group>
                <group>
                    <field name="quotation_client_logo" widget="image" class="oe_avatar"/>
                </group>
            </xpath>

            <!-- Cost-breakdown columns on the real order lines
                 (SaleOrderLine in sale_order.py), matching the same
                 columns the Opportunity's Project Lines table has. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="code" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="after">
                <field name="list_price" optional="show"/>
                <field name="freight_percent" string="Freight &amp; Custom" optional="show"/>
                <field name="exchange_rate" optional="hide"/>
                <field name="profit_percent" string="Profit %age" optional="show"/>
                <field name="unit_cost" string="Unit Cost In SR" optional="show"/>
                <field name="total_cost" string="Total Cost In SR" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
