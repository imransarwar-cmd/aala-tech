            <field name="company_id" eval="False"/>
        </record>

        <record id="salary_rule_dvz_leave_encash" model="hr.salary.rule">
            <field name="name">Leave Encashment</field>
            <field name="code">DVZ_LEAVE_ENCASH</field>
            <field name="sequence">20</field>
            <field name="company_id" eval="False"/>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="dvz_benefit_rule" eval="True"/>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python"><![CDATA[
result = payslip.dict._dvz_input_amount('DVZ_LEAVE_ENCASH', contract.id) != 0.0 or payslip.dict._dvz_input_amount('DVZ_LEAVE_DAYS', contract.id) != 0.0
]]></field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
result = payslip.dict._dvz_input_amount('DVZ_LEAVE_ENCASH', contract.id)
dvz_days = payslip.dict._dvz_input_amount('DVZ_LEAVE_DAYS', contract.id)
if dvz_days:
    dvz_base = contract.wage if contract.dvz_salary_base == 'wage' else contract.dvz_custom_salary_base
    result += dvz_days * dvz_base / contract.dvz_salary_days_divisor
]]></field>
            <field name="note">Approved cash amount plus encashment days × selected salary base ÷ configured salary-days divisor. Enter a cash amount or days for the same entitlement; if both are entered they are added. This is a payroll payment only and does not reduce Time Off allocations.</field>
        </record>
        <record id="input_dvz_leave_encash" model="hr.rule.input">
            <field name="name">Leave Encashment — Approved Cash Amount</field>
            <field name="code">DVZ_LEAVE_ENCASH</field>
            <field name="input_id" ref="salary_rule_dvz_leave_encash"/>
        </record>
        <record id="input_dvz_leave_days" model="hr.rule.input">
            <field name="name">Leave Encashment — Days (Quantity)</field>
            <field name="code">DVZ_LEAVE_DAYS</field>
            <field name="input_id" ref="salary_rule_dvz_leave_encash"/>
        </record>

