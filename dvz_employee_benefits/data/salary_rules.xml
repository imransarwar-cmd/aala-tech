        <record id="salary_rule_dvz_pf_employee" model="hr.salary.rule">
            <field name="name">Provident Fund — Employee Deduction</field>
            <field name="code">DVZ_PF_EMPLOYEE</field>
            <field name="sequence">66</field>
            <field name="company_id" eval="False"/>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="dvz_benefit_rule" eval="True"/>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python"><![CDATA[
result = contract.dvz_pf_enabled and contract.dvz_pf_employee_rate > 0.0
]]></field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
dvz_pf_base = contract.wage if contract.dvz_pf_base == 'wage' else contract.dvz_pf_custom_base
dvz_pf_amount = dvz_pf_base * contract.dvz_pf_employee_rate / 100.0
if contract.dvz_pf_employee_cap > 0.0:
    dvz_pf_amount = min(dvz_pf_amount, contract.dvz_pf_employee_cap)
result = -dvz_pf_amount
]]></field>
            <field name="note">Employee PF contribution is a negative deduction: selected PF base × employee rate, capped at the configured employee amount when nonzero. Zero cap means unlimited. Configure rates and eligibility according to the applicable company policy.</field>
        </record>

        <record id="salary_rule_dvz_pf_employer" model="hr.salary.rule">
            <field name="name">Provident Fund — Employer Contribution</field>
            <field name="code">DVZ_PF_EMPLOYER</field>
            <field name="sequence">67</field>
            <field name="company_id" eval="False"/>
            <field name="category_id" ref="category_dvz_company_contribution"/>
            <field name="dvz_benefit_rule" eval="True"/>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python"><![CDATA[
result = contract.dvz_pf_enabled and contract.dvz_pf_employer_rate > 0.0
]]></field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
dvz_pf_base = contract.wage if contract.dvz_pf_base == 'wage' else contract.dvz_pf_custom_base
dvz_pf_amount = dvz_pf_base * contract.dvz_pf_employer_rate / 100.0
if contract.dvz_pf_employer_cap > 0.0:
    dvz_pf_amount = min(dvz_pf_amount, contract.dvz_pf_employer_cap)
result = dvz_pf_amount
]]></field>
            <field name="note">Employer PF contribution is a company cost: selected PF base × employer rate, capped at the configured employer amount when nonzero. Its independent DVZ_COMP category keeps it out of employee gross and net pay. Zero cap means unlimited.</field>
        </record>
    </data>
</odoo>

