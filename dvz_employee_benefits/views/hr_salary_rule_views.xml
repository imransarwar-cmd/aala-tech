<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_salary_rule_native_benefit_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.native.benefit.form</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="om_hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/group/field[@name='code']" position="after">
                <field name="dvz_benefit_rule" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_hr_salary_rule_native_benefit_list" model="ir.ui.view">
        <field name="name">hr.salary.rule.native.benefit.list</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="om_hr_payroll.hr_salary_rule_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='code']" position="after">
                <field name="dvz_benefit_rule" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="view_hr_salary_rule_native_benefit_search" model="ir.ui.view">
        <field name="name">hr.salary.rule.native.benefit.search</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_rule_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="dvz_benefits" string="Employee Benefits" domain="[('dvz_benefit_rule', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
